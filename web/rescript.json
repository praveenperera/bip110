{
  "name": "web",
  "sources": [
    {
      "dir": "src",
      "subdirs": true
    },
    {
      "dir": "tests",
      "type": "dev"
    }
  ],
  "dependencies": ["@rescript/react"],
  "jsx": {
    "version": 4
  },
  "package-specs": {
    "module": "esmodule",
    "in-source": true
  },
  "suffix": ".res.js",
  "warnings": {
    "error": "+A"
  },
  "gentypeconfig": {
    "module": "esmodule",
    "moduleResolution": "bundler",
    "generatedFileExtension": ".gen.ts"
  }
}
