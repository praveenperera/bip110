{
  "name": "web",
  "type": "module",
  "version": "0.0.1",
  "scripts": {
    "res:build": "rescript",
    "res:format": "rescript format",
    "res:format:check": "rescript format --check",
    "predev": "npm run res:build",
    "dev": "astro dev --host",
    "build": "npm run res:build && astro build",
    "preview": "astro preview",
    "astro": "astro",
    "format": "npm run res:format && prettier --write .",
    "format:check": "npm run res:format:check && prettier --check .",
    "typecheck": "npm run res:build && tsc --noEmit --allowJs false",
    "test": "npm run res:build && node --test tests/*.test.mjs",
    "check": "npm run format:check && npm run typecheck && npm run test && npm run build"
  },
  "dependencies": {
    "@astrojs/react": "^6.0.0",
    "@base-ui/react": "^1.1.0",
    "@rescript/react": "^0.15.0",
    "@tailwindcss/vite": "^4.3.1",
    "@types/react": "^19.2.7",
    "@types/react-dom": "^19.2.3",
    "astro": "^7.0.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "lucide-react": "^0.563.0",
    "react": "^19.2.3",
    "react-dom": "^19.2.3",
    "recharts": "^3.8.1",
    "shiki": "^4.3.1",
    "tailwind-merge": "^3.4.0",
    "tailwindcss": "^4.3.1"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^4.20260610.1",
    "prettier": "^3.8.1",
    "prettier-plugin-astro": "^0.14.1",
    "rescript": "^12.3.0",
    "tw-animate-css": "^1.4.0",
    "typescript": "^5.9.3",
    "vite": "^8.0.16",
    "wrangler": "^4.99.0"
  }
}
