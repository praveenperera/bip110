---
import { motivation } from '@/lib/content';
---

<section id="why" class="py-24 px-6 bg-muted/30">
  <div class="max-w-4xl mx-auto">
    <h2 class="text-3xl font-bold text-center mb-12">
      {motivation.headline}
    </h2>

    <div class="space-y-8">
      {motivation.paragraphs.map((paragraph) => (
        <p class="text-lg leading-relaxed text-muted-foreground">
          {paragraph}
        </p>
      ))}
    </div>

    <div class="mt-10 rounded-lg border border-border/50 bg-card/50 p-5">
      <p class="text-sm font-medium uppercase tracking-wide text-primary">
        Evidence archive
      </p>
      <a
        href="https://wtfhappenedinfeb2023.com/"
        target="_blank"
        rel="noopener noreferrer"
        class="mt-2 inline-flex text-lg font-semibold text-foreground transition-colors hover:text-primary"
      >
        WTF Happened in Feb 2023?
      </a>
      <p class="mt-2 text-sm leading-relaxed text-muted-foreground">
        Review the blockspace, fee pressure, and node-resource data behind the
        February 2023 spam wave.
      </p>
    </div>

    <div class="mt-12 p-6 rounded-xl bg-primary/5 border border-primary/20">
      <p class="text-center font-medium text-lg" set:html="&ldquo;Bitcoin should do one thing, and do it well.&rdquo;">
      </p>
    </div>
  </div>
</section>
