    type === "skip" && "text-muted-foreground/60",
    type === "context" && "text-muted-foreground",
  ]
    .filter(Boolean)
    .join(" ");

const codeLineMarkerClass = (type: string) =>
  [
    "select-none text-center",
    type === "added" && "text-emerald-700 dark:text-emerald-400",
    type === "removed" && "text-red-700 dark:text-red-400",
    type !== "added" && type !== "removed" && "text-muted-foreground/70",
  ]
    .filter(Boolean)
    .join(" ");

const codeLineMarker = (type: string) => {
  if (type === "added") return "+";
  if (type === "removed") return "-";
  return "";
};

const highlighter = await createHighlighter({
  langs: ["cpp"],
  themes: ["github-light", "github-dark"],
});

type SyntaxToken = {
  text: string;
  style: string;
};

const shikiTokenStyle = (
  htmlStyle?: Record<string, string | number>,
): string => {
  if (!htmlStyle) return "";

  return Object.entries(htmlStyle)
    .map(([property, value]) => `${property}:${value}`)
    .join(";");
};

const highlightCpp = (code: string): SyntaxToken[] => {
  const result = highlighter.codeToTokens(code, {
    lang: "cpp",
    themes: {
      light: "github-light",
      dark: "github-dark",
    },
  });

  const tokens = result.tokens[0] ?? [];

  return tokens.map((token) => ({
    text: token.content,
    style: shikiTokenStyle(token.htmlStyle),
  }));
};

