---
import Layout from "@/layouts/Layout.astro";
import Header from "@/components/Header.astro";
import Footer from "@/components/Footer.astro";
import { MonitorBlockGrid } from "@/components/MonitorDashboard";

const stats = [
  {
    label: "Indexed tip",
    value: "N/A",
    detail: "Loading chain state",
    valueField: "indexed-tip",
    detailField: "indexed-tip-detail",
  },
  {
    label: "Chain tip",
    value: "N/A",
    detail: "Loading chain state",
    valueField: "chain-tip",
    detailField: "chain-tip-detail",
  },
  {
    label: "Period signal rate",
    value: "0.00%",
    detail: "0 blocks signaling",
    alert: true,
  },
  {
    label: "Activation target",
    value: "N/A",
    detail: "No URSF activation target",
    alert: true,
  },
];

const historyRows = [
  {
    isCurrent: true,
    periodField: "history-current-period",
    period: "current",
    firstBlock: "Loading",
    firstBlockField: "history-current-start",
    lastBlock: "Loading",
    lastBlockField: "history-current-end",
    tracked: "Loading",
    trackedField: "history-current-tracked",
    signaling: "0",
    percent: "0.00%",
  },
  {
    isCurrent: false,
    periodField: "history-previous-period",
    period: "previous",
    firstBlock: "Loading",
    firstBlockField: "history-previous-start",
    lastBlock: "Loading",
    lastBlockField: "history-previous-end",
    tracked: "Loading",
    trackedField: "history-previous-tracked",
    signaling: "0",
    percent: "0.00%",
  },
];
---

<Layout
  title="URSF Monitor - Bitcoin Signaling Status"
  description="Real-time Bitcoin miner version-bit signaling tracker by difficulty adjustment period."
  ogTitle="URSF Status | Bitcoin Signaling Monitor"
  ogImage="/images/ursf-monitor-og.png"
>
  <main class="ursf-monitor-page min-h-screen">
    <Header />

    <section id="overview" class="px-4 pb-20 pt-24 sm:px-6">
      <div class="mx-auto max-w-6xl">
        <div
          class="ursf-border mb-8 flex flex-col gap-5 border-b pb-6 lg:flex-row lg:items-end lg:justify-between"
        >
          <div>
            <h1
              class="ursf-heading font-mono text-3xl font-semibold tracking-normal sm:text-5xl"
            >
              <a
                href="#overview"
                class="inline-flex rounded-sm text-current transition-colors hover:text-[var(--ursf-accent)] hover:underline focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-[var(--ursf-accent)] focus-visible:ring-offset-2 focus-visible:ring-offset-[var(--ursf-bg)]"
              >
                URSF MONITOR
              </a>
            </h1>
            <p class="ursf-muted mt-2 text-sm">
              Bitcoin signaling monitor - no URSF blocks observed
            </p>
          </div>

          <div class="flex flex-wrap items-center gap-3 text-sm">
            <a
              href="/monitor"
              class="ursf-link-button inline-flex items-center rounded-md border px-3 py-2 font-medium transition-colors"
            >
              bip110 monitor
            </a>
          </div>
        </div>

        <div
          class="ursf-alert-card mb-6 rounded-lg border p-5 shadow-2xl shadow-black/10 dark:shadow-black/40"
        >
          <p class="ursf-alert text-sm font-semibold">
            Current URSF Signaling Status - Difficulty Adjustment Period <span
              data-ursf-field="status-period">N/A</span
            >: <span class="font-mono">0.00%</span> of blocks signaling
          </p>
        </div>

        <div class="grid gap-3 sm:grid-cols-2 lg:grid-cols-4">
          {
            stats.map((stat) => (
              <article class="ursf-card rounded-lg border p-4">
                <p class="ursf-label text-xs font-medium uppercase tracking-wide">
                  {stat.label}
                </p>
                <p
                  class:list={[
                    "mt-3 font-mono text-4xl font-semibold tracking-normal",
                    stat.alert ? "ursf-alert" : "ursf-heading",
                  ]}
                >
                  <span data-ursf-field={stat.valueField}>{stat.value}</span>
                </p>
                <p
                  class:list={[
                    "mt-2 text-sm",
                    stat.alert ? "ursf-alert font-medium" : "ursf-muted",
                  ]}
                  data-ursf-field={stat.detailField}
                >
                  {stat.detail}
                </p>
              </article>
            ))
          }
        </div>

        <div
          class="mt-6 grid gap-6 lg:grid-cols-[minmax(0,1.35fr)_minmax(300px,0.65fr)]"
        >
          <section
            id="current-period"
            class="ursf-card scroll-mt-24 rounded-lg border p-5"
          >
            <div
              class="flex flex-col gap-4 sm:flex-row sm:items-start sm:justify-between"
            >
              <div>
                <p
                  class="ursf-label text-xs font-medium uppercase tracking-wide"
                >
                  <a
                    href="#current-period"
                    class="inline-flex rounded-sm text-current transition-colors hover:text-[var(--ursf-accent)] hover:underline focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-[var(--ursf-accent)] focus-visible:ring-offset-2 focus-visible:ring-offset-[var(--ursf-card)]"
                  >
                    Current Difficulty Adjustment Period
                  </a>
                </p>
                <p
                  class="ursf-heading mt-2 font-mono text-5xl font-semibold tracking-normal"
                >
                  <span data-ursf-field="period-num">N/A</span>
                </p>
              </div>
              <div class="ursf-pill rounded-md border px-4 py-3 text-sm">
                <span
                  class="ursf-heading font-mono"
                  data-ursf-field="period-start"
                >
                  N/A
                </span>
                <span class="ursf-muted px-2">-</span>
                <span
                  class="ursf-heading font-mono"
                  data-ursf-field="period-end"
                >
                  N/A
                </span>
              </div>
            </div>

            <div class="mt-6 grid gap-3 sm:grid-cols-3">
              <div class="ursf-soft-card rounded-md p-4">
                <p class="ursf-label text-xs uppercase tracking-wide">
                  Blocks left
                </p>
                <p class="ursf-heading mt-2 font-mono text-2xl">
                  <span data-ursf-field="blocks-left">N/A</span>
                </p>
                <p
                  class="ursf-muted text-sm"
                  data-ursf-field="blocks-left-detail"
                >
                  Loading chain state
                </p>
              </div>
              <div class="ursf-soft-card rounded-md p-4">
                <p class="ursf-label text-xs uppercase tracking-wide">
                  Signaling blocks
                </p>
                <p class="ursf-alert mt-2 font-mono text-2xl font-semibold">0</p>
                <p class="ursf-alert text-sm font-medium">observed</p>
              </div>
              <div class="ursf-soft-card rounded-md p-4">
                <p class="ursf-label text-xs uppercase tracking-wide">
                  Activation target
                </p>
                <p class="ursf-alert mt-2 font-mono text-2xl font-semibold">
                  N/A
                </p>
                <p class="ursf-alert text-sm font-medium">No URSF target</p>
              </div>
            </div>

            <div class="mt-6 space-y-5">
              <div>
                <div class="mb-2 flex items-end justify-between gap-3">
                  <div>
                    <p class="ursf-alert text-sm font-semibold">
                      Signaling rate
                    </p>
                    <p class="ursf-alert text-xs font-medium">
                      0 signaling blocks observed
                    </p>
                  </div>
                  <p class="ursf-alert font-mono text-sm font-semibold">
                    0.00%
                  </p>
                </div>
                <div
                  class="ursf-progress-track h-3 overflow-hidden rounded-full"
                >
                  <div class="ursf-alert-progress h-full w-0 rounded-full"></div>
                </div>
              </div>

              <div>
                <div class="mb-2 flex items-end justify-between gap-3">
                  <div>
                    <p class="ursf-heading text-sm font-medium">
                      Period progress
                    </p>
                    <p class="ursf-muted text-xs">
                      Current Bitcoin difficulty period
                    </p>
                  </div>
                  <p
                    class="ursf-muted font-mono text-sm"
                    data-ursf-field="period-progress"
                  >
                    N/A
                  </p>
                </div>
                <div
                  class="ursf-progress-track h-3 overflow-hidden rounded-full"
                >
                  <div
                    class="h-full w-0 rounded-full bg-sky-400"
                    data-ursf-progress="period"
                  >
                  </div>
                </div>
              </div>
            </div>
          </section>

          <aside
            id="rules"
            class="ursf-card scroll-mt-24 rounded-lg border p-5"
          >
            <p class="ursf-label text-xs font-medium uppercase tracking-wide">
              <a
                href="#rules"
                class="inline-flex rounded-sm text-current transition-colors hover:text-[var(--ursf-accent)] hover:underline focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-[var(--ursf-accent)] focus-visible:ring-offset-2 focus-visible:ring-offset-[var(--ursf-card)]"
              >
                URSF Rules
              </a>
            </p>
            <div class="ursf-muted mt-4 space-y-3 text-sm">
              <div class="ursf-card rounded-md border p-3">
                <p class="ursf-heading font-medium">Signal bit</p>
                <p>None. There is no miner signaling ceremony here.</p>
              </div>
              <div class="ursf-card rounded-md border p-3">
                <p class="ursf-heading font-medium">Activation</p>
                <p>No activation window exists.</p>
              </div>
            </div>
          </aside>
        </div>

        <section
          id="difficulty-adjustment-period-history"
          class="ursf-card mt-6 scroll-mt-24 rounded-lg border p-5"
        >
          <h2 class="ursf-heading text-xl font-semibold tracking-tight">
            <a
              href="#difficulty-adjustment-period-history"
              class="inline-flex rounded-sm text-current transition-colors hover:text-[var(--ursf-accent)] hover:underline focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-[var(--ursf-accent)] focus-visible:ring-offset-2 focus-visible:ring-offset-[var(--ursf-card)]"
            >
              Difficulty Adjustment Period History
            </a>
          </h2>
          <div class="mt-5" data-ursf-period-chart>
            <div
              class="ursf-muted rounded-lg border border-dashed border-[var(--ursf-border)] bg-[var(--ursf-soft)] p-6 text-sm"
            >
              Loading period chart
            </div>
          </div>

          <div class="mt-6 overflow-x-auto">
            <table class="w-full min-w-160 text-left text-sm">
              <thead
                class="ursf-border ursf-label border-b text-xs uppercase tracking-wide"
              >
                <tr>
                  <th class="py-3 pl-4 pr-4 font-medium">Period</th>
                  <th class="py-3 pr-4 font-medium">First block</th>
                  <th class="py-3 pr-4 font-medium">Last block</th>
                  <th class="py-3 pr-4 font-medium">Blocks tracked</th>
                  <th class="py-3 pr-4 font-medium">Signaling</th>
                  <th class="py-3 font-medium">Signal %</th>
                </tr>
              </thead>
              <tbody class="ursf-history-body" data-ursf-history-body>
                {
                  historyRows.map((row) => (
                    <tr class={row.isCurrent ? "ursf-current-period" : undefined}>
                      <td class="ursf-heading py-3 pl-4 pr-4 font-medium">
                        <div class="flex flex-wrap items-center gap-2">
                          <span data-ursf-field={row.periodField}>
                            {row.period}
                          </span>
                          {row.isCurrent && (
                            <span class="ursf-current-badge inline-flex h-5 items-center rounded-full border px-2 text-[0.7rem] font-medium leading-none">
                              Current
                            </span>
                          )}
                        </div>
                      </td>
                      <td class="ursf-muted py-3 pr-4 font-mono">
                        <span data-ursf-field={row.firstBlockField}>
                          {row.firstBlock}
                        </span>
                      </td>
                      <td class="ursf-muted py-3 pr-4 font-mono">
                        <span data-ursf-field={row.lastBlockField}>
                          {row.lastBlock}
                        </span>
                      </td>
                      <td class="ursf-muted py-3 pr-4 font-mono">
                        <span data-ursf-field={row.trackedField}>
                          {row.tracked}
                        </span>
                      </td>
                      <td class="ursf-alert py-3 pr-4 font-mono font-semibold">
                        {row.signaling}
                      </td>
                      <td class="ursf-alert py-3 font-mono font-semibold">
                        {row.percent}
                      </td>
                    </tr>
                  ))
                }
              </tbody>
            </table>
          </div>
        </section>

        <section
          id="block-grid"
          class="ursf-card mt-6 rounded-lg border p-5"
          data-ursf-static
          aria-labelledby="ursf-static-block-grid-title"
        >
          <div
            class="flex flex-col gap-4 sm:flex-row sm:items-start sm:justify-between"
          >
            <div>
              <p class="ursf-label text-xs font-medium uppercase tracking-wide">
                Recent blocks
              </p>
              <h2
                id="ursf-static-block-grid-title"
                class="ursf-heading mt-1 text-xl font-semibold tracking-tight"
              >
                <a
                  href="#block-grid"
                  class="inline-flex rounded-sm text-current transition-colors hover:text-[var(--ursf-accent)] hover:underline focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-[var(--ursf-accent)] focus-visible:ring-offset-2 focus-visible:ring-offset-[var(--ursf-card)]"
                >
                  All quiet
                </a>
              </h2>
              <p class="ursf-muted mt-2 max-w-2xl text-sm">
                Server-rendered Bitcoin block snapshot. Enable JavaScript for
                live refreshes and interactive tooltips.
              </p>
            </div>
            <div
              class="ursf-muted flex flex-wrap items-center gap-x-4 gap-y-2 text-xs"
            >
              <span class="inline-flex items-center gap-2">
                <span
                  class="ursf-block-dot size-3 rounded-sm border border-[var(--ursf-border)]"
                  aria-hidden="true"></span>
                Not signaling
              </span>
            </div>
          </div>

          <div
            class="mt-5 grid grid-cols-[repeat(auto-fill,minmax(4.75rem,1fr))] gap-2 sm:grid-cols-[repeat(auto-fill,minmax(5.5rem,1fr))]"
            data-ursf-block-grid
          >
            <p class="ursf-muted col-span-full text-sm">
              Loading block snapshot
            </p>
          </div>
        </section>

        <div data-monitor-react>
          <MonitorBlockGrid mode="ursf" client:load />
        </div>

        <a
          href="/monitor"
          class="ursf-monitor-link mt-6 block rounded-lg border p-5 transition-colors"
        >
          <p class="ursf-label text-xs font-medium uppercase tracking-wide">
            Live BIP-110 Monitor
          </p>
          <h2 class="ursf-heading mt-2 text-xl font-semibold tracking-tight">
            Monitor BIP-110 progress
          </h2>
          <p class="ursf-muted mt-2 text-sm">
            Track actual BIP-110 signaling status, period progress, and
            difficulty adjustment history.
          </p>
        </a>
      </div>
    </section>

    <script>
      import { parseMonitorData } from "@/lib/monitor";

      const API_URL = "/api/monitor";
      const LOCAL_DEV_API_URL = "https://bip110monitor.com/api";
      const CACHE_KEY = "bip110-monitor-data";
      const MONITOR_DATA_EVENT = "bip110-monitor-data";
      const CACHE_VERSION = 2;
      const CACHE_TTL_MS = 60_000;
      const PERIOD_BLOCK_COUNT = 2016;

      function readCachedMonitorData() {
        try {
          const cached = window.localStorage.getItem(CACHE_KEY);
          if (!cached) return null;

          const parsed = JSON.parse(cached);
          if (
            typeof parsed !== "object" ||
            parsed === null ||
            parsed.version !== CACHE_VERSION ||
            typeof parsed.cachedAt !== "number"
          ) {
            return null;
          }

          return {
            cachedAt: parsed.cachedAt,
            data: parseMonitorData(parsed.data),
            version: CACHE_VERSION,
          };
        } catch {
          return null;
        }
      }

      function writeCachedMonitorData(data, cachedAt) {
        try {
          window.localStorage.setItem(
            CACHE_KEY,
            JSON.stringify({ cachedAt, data, version: CACHE_VERSION }),
          );
        } catch {}

        window.dispatchEvent(
          new CustomEvent(MONITOR_DATA_EVENT, {
            detail: { cachedAt, data },
          }),
        );
      }

      function isPageVisible() {
        return document.visibilityState === "visible";
      }

      function isCacheStale(cachedAt) {
        return Date.now() - cachedAt > CACHE_TTL_MS;
      }

      function shouldRefreshCachedMonitorData() {
        const cached = readCachedMonitorData();
        return !cached || isCacheStale(cached.cachedAt);
      }

      function isLocalDevHost() {
        return ["127.0.0.1", "localhost", "::1"].includes(
          window.location.hostname,
        );
      }

      async function fetchMonitorData() {
        const response = await fetch(API_URL);

        if (response.ok) {
          return parseMonitorData(await response.json());
        }

        if (response.status === 404 && isLocalDevHost()) {
          const fallbackResponse = await fetch(LOCAL_DEV_API_URL);

          if (fallbackResponse.ok) {
            return parseMonitorData(await fallbackResponse.json());
          }
        }

        throw new Error(`Monitor API returned ${response.status}`);
      }

      function formatNumber(value) {
        return new Intl.NumberFormat("en-US").format(value);
      }

      function formatEstimatedTime(blocks) {
        const minutes = blocks * 10;
        const days = minutes / 1440;

        if (days >= 2) {
          return `~${days.toFixed(days >= 10 ? 0 : 1)} days`;
        }

        const hours = minutes / 60;

        if (hours >= 1) {
          return `~${hours.toFixed(hours >= 10 ? 0 : 1)} hours`;
        }

        return `~${minutes} minutes`;
      }

      function formatPercent(value) {
        return `${value.toFixed(2)}%`;
      }

      function escapeHtml(value) {
        return value
          .replaceAll("&", "&amp;")
          .replaceAll('"', "&quot;")
          .replaceAll("<", "&lt;")
          .replaceAll(">", "&gt;");
      }

      function setText(field, value) {
        for (const element of document.querySelectorAll(
          `[data-ursf-field="${field}"]`,
        )) {
          element.textContent = value;
        }
      }

      function currentPeriodFromMonitorData(data) {
        return {
          endBlock: data.periodEnd,
          periodNum: data.periodNum,
          startBlock: data.periodStart,
          totalBlocks: data.totalBlocks,
        };
      }

      function historyPeriodsFor(data) {
        const previousPeriods = Array.isArray(data.periods)
          ? data.periods
              .filter((period) => period.periodNum !== data.periodNum)
              .sort((a, b) => b.periodNum - a.periodNum)
          : [
              {
                endBlock: data.periodStart - 1,
                periodNum: data.periodNum - 1,
                startBlock: data.periodStart - PERIOD_BLOCK_COUNT,
                totalBlocks: PERIOD_BLOCK_COUNT,
              },
            ];

        return [currentPeriodFromMonitorData(data), ...previousPeriods];
      }

      function renderUrsfHistory(data) {
        const body = document.querySelector("[data-ursf-history-body]");
        if (!(body instanceof HTMLElement)) return;

        body.innerHTML = historyPeriodsFor(data)
          .map((period) => {
            const isCurrentPeriod = period.periodNum === data.periodNum;
            const rowClass = isCurrentPeriod ? ' class="ursf-current-period"' : "";
            const badge = isCurrentPeriod
              ? '<span class="ursf-current-badge inline-flex h-5 items-center rounded-full border px-2 text-[0.7rem] font-medium leading-none">Current</span>'
              : "";

            return [
              `<tr${rowClass}>`,
              '<td class="ursf-heading py-3 pl-4 pr-4 font-medium">',
              '<div class="flex flex-wrap items-center gap-2">',
              `<span>${formatNumber(period.periodNum)}</span>`,
              badge,
              "</div>",
              "</td>",
              `<td class="ursf-muted py-3 pr-4 font-mono">${formatNumber(period.startBlock)}</td>`,
              `<td class="ursf-muted py-3 pr-4 font-mono">${formatNumber(period.endBlock)}</td>`,
              `<td class="ursf-muted py-3 pr-4 font-mono">${formatNumber(period.totalBlocks)} / ${formatNumber(PERIOD_BLOCK_COUNT)}</td>`,
              '<td class="ursf-alert py-3 pr-4 font-mono font-semibold">0</td>',
              '<td class="ursf-alert py-3 font-mono font-semibold">0.00%</td>',
              "</tr>",
            ].join("");
          })
          .join("");
      }

      function renderUrsfPeriodChart(data) {
        const chart = document.querySelector("[data-ursf-period-chart]");
        if (!(chart instanceof HTMLElement)) return;

        const periods = [...historyPeriodsFor(data)].sort(
          (a, b) => a.periodNum - b.periodNum,
        );

        if (periods.length === 0) {
          chart.innerHTML =
            '<div class="ursf-muted rounded-lg border border-dashed border-[var(--ursf-border)] bg-[var(--ursf-soft)] p-6 text-sm">No period history available for charting.</div>';
          return;
        }

        const availableWidth = Math.floor(chart.getBoundingClientRect().width);
        const chartWidth = Math.max(640, availableWidth, periods.length * 76 + 88);
        const chartHeight = 288;
        const margin = { bottom: 58, left: 64, right: 24, top: 28 };
        const plotHeight = chartHeight - margin.top - margin.bottom;
        const plotWidth = chartWidth - margin.left - margin.right;
        const maxValue = 5;
        const yTicks = [maxValue, Math.round(maxValue / 2), 0];
        const pointY = margin.top + plotHeight;
        const points = periods.map((period, index) => ({
          period,
          x:
            periods.length === 1
              ? margin.left + plotWidth / 2
              : margin.left + (plotWidth / (periods.length - 1)) * index,
        }));
        const linePath = points
          .map((point, index) => `${index === 0 ? "M" : "L"} ${point.x} ${pointY}`)
          .join(" ");
        const yTickHtml = yTicks
          .map((tick) => {
            const y = margin.top + plotHeight - (tick / maxValue) * plotHeight;

            return [
              "<g>",
              `<line x1="${margin.left}" x2="${chartWidth - margin.right}" y1="${y}" y2="${y}" stroke="currentColor" stroke-opacity="0.16" />`,
              `<text x="${margin.left - 12}" y="${y + 4}" text-anchor="end" class="fill-current font-mono text-[11px]">${formatNumber(tick)}</text>`,
              "</g>",
            ].join("");
          })
          .join("");
        const pointHtml = points
          .map(({ period, x }) => {
            const isCurrentPeriod = period.periodNum === data.periodNum;
            const title = escapeHtml(
              `Period ${period.periodNum}: 0 signaling blocks (${formatPercent(0)})`,
            );
            const currentLabel = isCurrentPeriod
              ? `<text x="${x}" y="${chartHeight - 14}" text-anchor="middle" class="fill-[var(--ursf-alert)] text-[10px] font-medium">current</text>`
              : "";

            return [
              `<g aria-label="${title}" class="period-chart-point outline-none" role="img" tabindex="0">`,
              `<title>${title}</title>`,
              `<circle cx="${x}" cy="${pointY}" r="${isCurrentPeriod ? "5.5" : "4.5"}" class="transition-[r,fill] duration-150" fill="var(--ursf-alert)" stroke="var(--ursf-bg)" stroke-width="3" />`,
              '<g class="period-chart-tooltip">',
              `<rect x="${x - 34}" y="${pointY - 40}" width="68" height="24" rx="6" class="fill-[var(--ursf-card)] stroke-[var(--ursf-border)]" />`,
              `<text x="${x}" y="${pointY - 23}" text-anchor="middle" class="fill-[var(--ursf-heading)] font-mono text-[11px]">0.00%</text>`,
              "</g>",
              `<text x="${x}" y="${pointY - 12}" text-anchor="middle" class="fill-current font-mono text-[11px]">0</text>`,
              `<text x="${x}" y="${chartHeight - 31}" text-anchor="middle" class="fill-current font-mono text-[11px]">${formatNumber(period.periodNum)}</text>`,
              currentLabel,
              "</g>",
            ].join("");
          })
          .join("");

        chart.innerHTML = [
          '<div class="flex flex-col gap-3 sm:flex-row sm:items-end sm:justify-between">',
          "<div>",
          '<h3 class="ursf-heading text-base font-semibold tracking-tight">URSF blocks by period</h3>',
          '<p class="ursf-muted mt-1 text-sm">The line remains at zero because no URSF signaling blocks are tracked.</p>',
          "</div>",
          '<div class="ursf-muted flex flex-wrap items-center gap-x-4 gap-y-2 text-xs">',
          '<span class="inline-flex items-center gap-2"><span class="size-3 rounded-full border-2 border-[var(--ursf-alert)] bg-[var(--ursf-bg)]" aria-hidden="true"></span>URSF blocks</span>',
          "</div>",
          "</div>",
          `<div class="ursf-muted mt-5 overflow-x-auto" role="img" aria-label="URSF block counts by difficulty adjustment period. Chart maximum is ${formatNumber(maxValue)} blocks.">`,
          '<div class="w-max">',
          `<svg class="max-w-none" width="${chartWidth}" height="${chartHeight}" viewBox="0 0 ${chartWidth} ${chartHeight}">`,
          yTickHtml,
          `<line x1="${margin.left}" x2="${margin.left}" y1="${margin.top}" y2="${margin.top + plotHeight}" stroke="currentColor" stroke-opacity="0.28" />`,
          `<line x1="${margin.left}" x2="${chartWidth - margin.right}" y1="${margin.top + plotHeight}" y2="${margin.top + plotHeight}" stroke="currentColor" stroke-opacity="0.28" />`,
          `<path d="${linePath}" fill="none" stroke="var(--ursf-alert)" stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" />`,
          pointHtml,
          "</svg>",
          '<p class="text-center text-[11px]">difficulty adjustment period</p>',
          "</div>",
          "</div>",
        ].join("");
      }

      function renderChainState(data) {
        const blocksLeft = Math.max(data.periodEnd - data.tip, 0);
        const progressPercent = Math.min(
          Math.max((data.totalBlocks / PERIOD_BLOCK_COUNT) * 100, 0),
          100,
        );

        setText("indexed-tip", formatNumber(data.tip));
        setText("indexed-tip-detail", "Current Bitcoin block height");
        setText("chain-tip", formatNumber(data.chainTip));
        setText("chain-tip-detail", "Latest Bitcoin chain height");
        setText("status-period", formatNumber(data.periodNum));
        setText("period-num", formatNumber(data.periodNum));
        setText("period-start", formatNumber(data.periodStart));
        setText("period-end", formatNumber(data.periodEnd));
        setText("blocks-left", formatNumber(blocksLeft));
        setText("blocks-left-detail", formatEstimatedTime(blocksLeft));
        setText(
          "period-progress",
          `${formatNumber(data.totalBlocks)} / ${formatNumber(PERIOD_BLOCK_COUNT)}`,
        );
        setText("history-current-start", formatNumber(data.periodStart));
        setText("history-current-end", formatNumber(data.periodEnd));
        setText("history-current-period", formatNumber(data.periodNum));
        setText(
          "history-current-tracked",
          `${formatNumber(data.totalBlocks)} / ${formatNumber(PERIOD_BLOCK_COUNT)}`,
        );

        const progress = document.querySelector(
          '[data-ursf-progress="period"]',
        );
        if (progress instanceof HTMLElement) {
          progress.style.width = `${progressPercent}%`;
        }

        renderUrsfPeriodChart(data);
        renderUrsfHistory(data);
      }

      const cachedMonitorData = readCachedMonitorData();
      if (cachedMonitorData) {
        renderChainState(cachedMonitorData.data);
      }

      let refreshInFlight = false;

      function refreshMonitorDataIfStale() {
        if (
          refreshInFlight ||
          !isPageVisible() ||
          !shouldRefreshCachedMonitorData()
        ) {
          return;
        }

        refreshInFlight = true;
        fetchMonitorData()
          .then((data) => {
            const cachedAt = Date.now();
            writeCachedMonitorData(data, cachedAt);
            renderChainState(data);
          })
          .catch(() => {})
          .finally(() => {
            refreshInFlight = false;
          });
      }

      refreshMonitorDataIfStale();
      window.addEventListener("focus", refreshMonitorDataIfStale);
      document.addEventListener(
        "visibilitychange",
        refreshMonitorDataIfStale,
      );
    </script>

    <Footer />
  </main>
</Layout>

