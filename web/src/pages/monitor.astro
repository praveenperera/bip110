---
import Layout from "@/layouts/Layout.astro";
import Header from "@/components/Header.astro";
import Footer from "@/components/Footer.astro";
import { MonitorDashboard } from "@/components/MonitorDashboard";

const stats = [
  {
    label: "Indexed tip",
    value: "N/A",
    detail: "Highest block indexed by the monitor",
    valueField: "indexed-tip",
  },
  {
    label: "Chain tip",
    value: "N/A",
    detail: "Latest Bitcoin chain height reported",
    valueField: "chain-tip",
  },
  {
    label: "Signal rate",
    value: "N/A",
    detail: "Current period target is 55%",
    valueField: "signal-rate",
  },
  {
    label: "Signals",
    value: "N/A",
    detail: "Blocks tracked this period",
    valueField: "signals",
  },
];

const historyRows = [
  {
    isCurrent: true,
    periodField: "history-current-period",
    period: "current",
    firstBlockField: "history-current-start",
    firstBlock: "Loading",
    lastBlockField: "history-current-end",
    lastBlock: "Loading",
    trackedField: "history-current-tracked",
    tracked: "Loading",
    signalingField: "history-current-signaling",
    signaling: "Loading",
    percentField: "history-current-percent",
    percent: "Loading",
  },
  {
    isCurrent: false,
    periodField: "history-previous-period",
    period: "previous",
    firstBlockField: "history-previous-start",
    firstBlock: "Loading",
    lastBlockField: "history-previous-end",
    lastBlock: "Loading",
    trackedField: "history-previous-tracked",
    tracked: "Loading",
    signalingField: "history-previous-signaling",
    signaling: "Loading",
    percentField: "history-previous-percent",
    percent: "Loading",
  },
];
---

<Layout
  title="BIP-110 Monitor — Live Signaling Status"
  description="Track live BIP-110 miner signaling status, current difficulty adjustment period progress, and historical signaling rates."
  ogImage="/og/monitor.png"
>
  <main class="min-h-screen">
    <Header />

    <section id="overview" class="pt-24 pb-24 px-6">
      <div class="max-w-6xl mx-auto">
        <div class="mb-12 max-w-3xl">
          <p class="text-sm font-medium uppercase tracking-wide text-primary">
            Live monitor
          </p>
          <h1 class="mt-3 text-4xl font-bold tracking-tight sm:text-5xl">
            <a
              href="#overview"
              class="inline-flex rounded-sm text-current transition-colors hover:text-primary hover:underline focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-ring focus-visible:ring-offset-2 focus-visible:ring-offset-background"
            >
              BIP-110 Signaling Status
            </a>
          </h1>
          <p class="mt-4 text-lg text-muted-foreground">
            Current activation signaling, period progress, and historical
            difficulty adjustment data from the public BIP-110 monitor.
          </p>
        </div>

        <section
          data-monitor-static
          class="space-y-6"
          aria-label="BIP-110 monitor static summary"
        >
          <div
            class="rounded-lg border border-border/60 bg-muted/25 px-4 py-3 shadow-sm shadow-foreground/5 dark:bg-card/60"
          >
            <div
              class="flex flex-col gap-2 sm:flex-row sm:items-center sm:justify-between"
            >
              <div>
                <p data-monitor-sync-status class="hidden">
                  <span data-monitor-field="sync-status"
                    >Loading monitor data</span
                  >
                </p>
                <p class="mt-1 text-sm text-muted-foreground">
                  Updated <span data-monitor-field="updated-at">N/A</span>
                </p>
              </div>
              <a
                href="https://bip110monitor.com"
                target="_blank"
                rel="noopener noreferrer"
                class="inline-flex w-fit items-center text-sm text-primary hover:underline"
              >
                Source monitor
              </a>
            </div>
          </div>

          <div class="grid gap-4 md:grid-cols-2 xl:grid-cols-4">
            {
              stats.map((stat) => (
                <article class="rounded-lg border border-border/50 bg-card/50 p-4">
                  <p class="text-xs font-medium uppercase tracking-wide text-muted-foreground">
                    {stat.label}
                  </p>
                  <p class="mt-2 text-3xl font-bold tracking-tight">
                    <span data-monitor-field={stat.valueField}>
                      {stat.value}
                    </span>
                  </p>
                  <p class="mt-1 text-sm text-muted-foreground">
                    {stat.detail}
                  </p>
                </article>
              ))
            }
          </div>

          <div
            class="grid gap-6 lg:grid-cols-[minmax(0,1.35fr)_minmax(320px,0.65fr)]"
          >
            <section
              id="current-period"
              class="scroll-mt-24 rounded-lg border border-border/50 bg-card/50 p-6"
            >
              <h2 class="text-xl font-semibold">
                <a
                  href="#current-period"
                  class="inline-flex rounded-sm text-current transition-colors hover:text-primary hover:underline focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-ring focus-visible:ring-offset-2 focus-visible:ring-offset-background"
                >
                  Difficulty Adjustment Period <span
                    data-monitor-field="period-num">N/A</span
                  >
                </a>
              </h2>
              <div class="mt-6 grid gap-4 sm:grid-cols-3">
                <div class="rounded-lg bg-muted/50 p-4">
                  <p
                    class="text-xs font-medium uppercase tracking-wide text-muted-foreground"
                  >
                    Block range
                  </p>
                  <p class="mt-2 text-sm font-medium">
                    <span data-monitor-field="period-start">N/A</span>
                    <span class="mx-2 text-muted-foreground">to</span>
                    <span data-monitor-field="period-end">N/A</span>
                  </p>
                </div>
                <div class="rounded-lg bg-muted/50 p-4">
                  <p
                    class="text-xs font-medium uppercase tracking-wide text-muted-foreground"
                  >
                    Blocks left
                  </p>
                  <p
                    class="mt-2 text-lg font-semibold"
                    data-monitor-field="blocks-left"
                  >
                    N/A
                  </p>
                  <p
                    class="text-sm text-muted-foreground"
                    data-monitor-field="blocks-left-detail"
                  >
                    Loading chain state
                  </p>
                </div>
                <div class="rounded-lg bg-muted/50 p-4">
                  <p
                    class="text-xs font-medium uppercase tracking-wide text-muted-foreground"
                  >
                    Threshold
                  </p>
                  <p
                    class="mt-2 text-lg font-semibold"
                    data-monitor-field="threshold"
                  >
                    N/A
                  </p>
                  <p class="text-sm text-muted-foreground">
                    signaling blocks required
                  </p>
                </div>
              </div>

              <div class="mt-6 space-y-5">
                <div>
                  <div class="mb-2 flex items-end justify-between gap-3">
                    <div>
                      <p class="text-sm font-medium">Signaling rate</p>
                      <p
                        class="text-xs text-muted-foreground"
                        data-monitor-field="signaling-detail"
                      >
                        Loading signaling data
                      </p>
                    </div>
                    <p
                      class="font-mono text-sm text-muted-foreground"
                      data-monitor-field="signal-rate"
                    >
                      N/A
                    </p>
                  </div>
                  <div class="h-3 overflow-hidden rounded-full bg-muted">
                    <div
                      class="h-full w-0 rounded-full bg-primary"
                      data-monitor-progress="activation"
                    >
                    </div>
                  </div>
                </div>

                <div>
                  <div class="mb-2 flex items-end justify-between gap-3">
                    <div>
                      <p class="text-sm font-medium">Period progress</p>
                      <p
                        class="text-xs text-muted-foreground"
                        data-monitor-field="period-detail"
                      >
                        Loading period data
                      </p>
                    </div>
                    <p
                      class="font-mono text-sm text-muted-foreground"
                      data-monitor-field="period-progress"
                    >
                      N/A
                    </p>
                  </div>
                  <div class="h-3 overflow-hidden rounded-full bg-muted">
                    <div
                      class="h-full w-0 rounded-full bg-foreground/70 dark:bg-foreground/80"
                      data-monitor-progress="period"
                    >
                    </div>
                  </div>
                </div>
              </div>
            </section>

            <section
              id="rules"
              class="scroll-mt-24 rounded-lg border border-border/50 bg-card/50 p-6"
            >
              <h2 class="text-xl font-semibold">
                <a
                  href="#rules"
                  class="inline-flex rounded-sm text-current transition-colors hover:text-primary hover:underline focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-ring focus-visible:ring-offset-2 focus-visible:ring-offset-background"
                >
                  BIP-110 Rules
                </a>
              </h2>
              <div class="mt-4 space-y-4 text-sm text-muted-foreground">
                <p>
                  BIP-110 is a temporary soft fork that limits data field sizes
                  to reduce blockchain bloat and refocus development on monetary
                  use cases.
                </p>
                <div class="grid gap-3">
                  <div class="rounded-lg border border-border/50 p-3">
                    <p class="font-medium text-foreground">Signal bit</p>
                    <p>Miners signal support by setting bit 4.</p>
                  </div>
                  <div class="rounded-lg border border-border/50 p-3">
                    <p class="font-medium text-foreground">Activation</p>
                    <p>
                      55% of blocks in one 2,016-block period must signal for
                      early lock-in.
                    </p>
                  </div>
                </div>
                <a
                  href="/code-walkthrough"
                  class="inline-flex items-center gap-2 rounded-md border border-primary/30 bg-primary/5 px-3 py-2 text-sm font-medium text-primary transition-colors hover:bg-primary hover:text-primary-foreground"
                >
                  Trace rules in code
                  <svg
                    class="h-4 w-4"
                    fill="none"
                    stroke="currentColor"
                    viewBox="0 0 24 24"
                    aria-hidden="true"
                  >
                    <path
                      stroke-linecap="round"
                      stroke-linejoin="round"
                      stroke-width="2"
                      d="M17 8l4 4m0 0l-4 4m4-4H3"></path>
                  </svg>
                </a>
              </div>
            </section>
          </div>

          <section
            id="difficulty-adjustment-period-history"
            class="scroll-mt-24 rounded-lg border border-border/50 bg-card/50 p-6"
          >
            <h2 class="text-xl font-semibold">
              <a
                href="#difficulty-adjustment-period-history"
                class="inline-flex rounded-sm text-current transition-colors hover:text-primary hover:underline focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-ring focus-visible:ring-offset-2 focus-visible:ring-offset-background"
              >
                Difficulty Adjustment Period History
              </a>
            </h2>
            <div class="mt-5" data-monitor-period-chart>
              <div
                class="rounded-lg border border-dashed border-border/60 bg-muted/20 p-6 text-sm text-muted-foreground"
              >
                Loading period chart
              </div>
            </div>

            <div class="mt-6 overflow-x-auto">
              <table class="w-full min-w-160 text-left text-sm">
                <thead
                  class="border-b border-border/50 text-xs uppercase tracking-wide text-muted-foreground"
                >
                  <tr>
                    <th class="py-3 pl-4 pr-4 font-medium">Period</th>
                    <th class="py-3 pr-4 font-medium">First block</th>
                    <th class="py-3 pr-4 font-medium">Last block</th>
                    <th class="py-3 pr-4 font-medium">Blocks tracked</th>
                    <th class="py-3 pr-4 font-medium">Signaling</th>
                    <th class="py-3 font-medium">Signal %</th>
                  </tr>
                </thead>
                <tbody class="divide-y divide-border/50">
                  {
                    historyRows.map((row) => (
                      <tr class={row.isCurrent ? "bg-primary/5" : undefined}>
                        <td class="py-3 pl-4 pr-4 font-medium">
                          <div class="flex flex-wrap items-center gap-2">
                            <span data-monitor-field={row.periodField}>
                              {row.period}
                            </span>
                            {row.isCurrent && (
                              <span class="inline-flex h-5 items-center rounded-full border border-primary/25 bg-primary/10 px-2 text-[0.7rem] font-medium leading-none text-primary">
                                Current
                              </span>
                            )}
                          </div>
                        </td>
                        <td
                          class="py-3 pr-4 text-muted-foreground"
                          data-monitor-field={row.firstBlockField}
                        >
                          {row.firstBlock}
                        </td>
                        <td
                          class="py-3 pr-4 text-muted-foreground"
                          data-monitor-field={row.lastBlockField}
                        >
                          {row.lastBlock}
                        </td>
                        <td
                          class="py-3 pr-4 text-muted-foreground"
                          data-monitor-field={row.trackedField}
                        >
                          {row.tracked}
                        </td>
                        <td
                          class="py-3 pr-4 text-muted-foreground"
                          data-monitor-field={row.signalingField}
                        >
                          {row.signaling}
                        </td>
                        <td
                          class="py-3 font-mono text-muted-foreground"
                          data-monitor-field={row.percentField}
                        >
                          {row.percent}
                        </td>
                      </tr>
                    ))
                  }
                </tbody>
              </table>
            </div>
          </section>

          <section
            id="recent-signaling"
            class="rounded-lg border border-border/50 bg-card/50 p-6"
            aria-labelledby="static-recent-signaling-title"
          >
            <p
              class="text-xs font-medium uppercase tracking-wide text-muted-foreground"
            >
              Recent signaling
            </p>
            <h2
              id="static-recent-signaling-title"
              class="mt-1 text-xl font-semibold tracking-tight"
            >
              <a
                href="#recent-signaling"
                class="inline-flex rounded-sm text-current transition-colors hover:text-primary hover:underline focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-ring focus-visible:ring-offset-2 focus-visible:ring-offset-background"
              >
                <span data-monitor-field="recent-signaling-heading"
                  >Last 48 blocks</span
                >
              </a>
            </h2>
            <p
              class="mt-5 font-mono text-4xl font-bold tracking-tight sm:text-5xl"
            >
              <span data-monitor-field="recent-signaling-pct">N/A</span>
            </p>
            <p class="mt-3 max-w-2xl text-sm text-foreground/80">
              <span data-monitor-field="recent-signaling-counts">Loading</span>
            </p>
            <p class="mt-1 max-w-2xl text-sm text-muted-foreground">
              <span data-monitor-field="recent-signaling-detail">Loading</span>
            </p>
          </section>

          <section
            id="block-grid"
            class="rounded-lg border border-border/50 bg-card/50 p-6"
            aria-labelledby="static-block-grid-title"
          >
            <div
              class="flex flex-col gap-4 sm:flex-row sm:items-start sm:justify-between"
            >
              <div>
                <p
                  class="text-xs font-medium uppercase tracking-wide text-muted-foreground"
                >
                  Current period blocks
                </p>
                <h2
                  id="static-block-grid-title"
                  class="mt-1 text-xl font-semibold tracking-tight"
                >
                  <a
                    href="#block-grid"
                    class="inline-flex rounded-sm text-current transition-colors hover:text-primary hover:underline focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-ring focus-visible:ring-offset-2 focus-visible:ring-offset-background"
                  >
                    Block signaling grid
                  </a>
                </h2>
                <p class="mt-2 max-w-2xl text-sm text-muted-foreground">
                  A server-rendered snapshot of recent blocks. Enable JavaScript
                  for live refreshes and interactive tooltips.
                </p>
              </div>
              <div
                class="flex flex-wrap items-center gap-x-4 gap-y-2 text-xs text-muted-foreground"
              >
                <span class="inline-flex items-center gap-2">
                  <span class="size-3 rounded-sm bg-primary" aria-hidden="true"
                  ></span>
                  Signaling
                </span>
                <span class="inline-flex items-center gap-2">
                  <span
                    class="size-3 rounded-sm border border-border bg-background"
                    aria-hidden="true"></span>
                  Not signaling
                </span>
                <span class="inline-flex items-center gap-2">
                  <span
                    class="relative size-3 rounded-sm border border-border bg-background"
                    aria-hidden="true"
                  >
                    <span
                      class="absolute -bottom-0.5 -right-0.5 text-xs font-bold leading-none text-primary"
                      >✓</span
                    >
                  </span>
                  Clean
                </span>
                <span class="inline-flex items-center gap-2">
                  <span
                    class="relative size-3 rounded-sm border border-primary bg-primary/20 ring-1 ring-primary/60"
                    aria-hidden="true"
                  >
                    <span
                      class="absolute -right-1 -top-1 text-[0.625rem] leading-none text-primary"
                      >✦</span
                    >
                  </span>
                  Miner&apos;s first-ever signal
                </span>
              </div>
            </div>

            <div
              class="mt-5 grid grid-cols-[repeat(auto-fill,minmax(4.75rem,1fr))] gap-2 sm:grid-cols-[repeat(auto-fill,minmax(5.5rem,1fr))]"
              data-monitor-block-grid
            >
              <p class="col-span-full text-sm text-muted-foreground">
                Loading block snapshot
              </p>
            </div>
          </section>
        </section>

        <div data-monitor-react>
          <MonitorDashboard client:load />
        </div>
      </div>
    </section>

    <Footer />
  </main>
</Layout>
