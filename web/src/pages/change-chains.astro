---
import CodeBlock from "@/components/responses/CodeBlock.astro";
import Footer from "@/components/Footer.astro";
import Header from "@/components/Header.astro";
import Layout from "@/layouts/Layout.astro";

const bitcoinFirstBlock =
  "00000000000000000000d1e01392faa65ceeaed307f0a3159144b84146ff24ba";
const bip110FirstBlock =
  "0000000000000000000169eb6f811ddbd0daf343af7b62180cdb13e7c78dbc16";

const checkCommands = `bitcoin-cli getbestblockhash
bitcoin-cli getblockhash 961632`;
const invalidateCommand = `bitcoin-cli invalidateblock ${bip110FirstBlock}`;
const verifyCommands = `bitcoin-cli getblockhash 961632
bitcoin-cli getblockchaininfo`;
const reconsiderCommand = `bitcoin-cli reconsiderblock ${bip110FirstBlock}`;
const dockerCheckCommands = `docker exec bitcoin bitcoin-cli -datadir=/data/.bitcoin getnetworkinfo
docker exec bitcoin bitcoin-cli -datadir=/data/.bitcoin getbestblockhash
docker exec bitcoin bitcoin-cli -datadir=/data/.bitcoin getblockhash 961632`;
const dockerRestartCommands = `docker compose pull bitcoin
docker compose up -d --no-deps --force-recreate bitcoin`;
const dockerInvalidateCommand = `docker exec bitcoin bitcoin-cli -datadir=/data/.bitcoin invalidateblock ${bip110FirstBlock}`;
const dockerFinishCommand = `docker exec bitcoin bitcoin-cli -datadir=/data/.bitcoin reconsiderblock ${bip110FirstBlock}`;
const umbrelBitcoinCliCommand =
  "sudo docker exec bitcoin-knots_app_1 bitcoin-cli -rpcport=9332";
const umbrelCheckCommands = `${umbrelBitcoinCliCommand} getbestblockhash
${umbrelBitcoinCliCommand} getblockhash 961632`;
const umbrelInvalidateCommand = `${umbrelBitcoinCliCommand} invalidateblock ${bip110FirstBlock}`;
const myNodeCheckCommands = `bitcoin-cli -datadir=/mnt/hdd/mynode/bitcoin getbestblockhash
bitcoin-cli -datadir=/mnt/hdd/mynode/bitcoin getblockhash 961632`;
const myNodeInvalidateCommand = `bitcoin-cli -datadir=/mnt/hdd/mynode/bitcoin invalidateblock ${bip110FirstBlock}`;
const startOsLegacyChecksumCommand = `shasum -a 256 bitcoind.s9pk`;
const startOsLegacySshCommand = `ssh start9@your-server-name.local`;
const startOsLegacyCheckCommands = `sudo docker exec bitcoind.embassy bitcoin-cli getbestblockhash
sudo docker exec bitcoind.embassy bitcoin-cli getblockhash 961632`;
const startOsLegacyInvalidateCommand = `sudo docker exec bitcoind.embassy bitcoin-cli invalidateblock ${bip110FirstBlock}`;
const startOsLegacyFinishCommand = `sudo docker exec bitcoind.embassy bitcoin-cli reconsiderblock ${bip110FirstBlock}`;
---

<Layout
  title="How to Switch to the Core Chain"
  description="If you choose to leave the two-block BIP-110 branch, this guide shows how to switch to the Core chain with pre-RDTS Bitcoin Knots."
  ogImage="/images/bip110-og-change-chains-dark.png"
  ogImageWidth="2400"
  ogImageHeight="1260"
  ogImageAlt="Instructions for operators who choose to switch to the Core chain"
>
  <main class="min-h-screen">
    <Header />

    <article class="px-6 pb-24 pt-28">
      <div class="mx-auto max-w-4xl">
        <header class="border-b border-border/60 pb-10">
          <p
            class="mb-4 text-xs font-semibold uppercase tracking-[0.16em] text-primary"
          >
            Changing chains
          </p>
          <h1 class="max-w-3xl text-4xl font-bold tracking-tight sm:text-5xl">
            Choosing the Core chain? Here is how to switch
          </h1>
          <p class="mt-6 max-w-3xl text-lg leading-8 text-muted-foreground">
            This guide is for node operators who choose to leave the two-block
            BIP-110 branch and switch to the Core chain.
          </p>
          <p class="mt-4 max-w-3xl text-lg leading-8 text-muted-foreground">
            Mandatory signaling started at height 961,632. The BIP-110 branch
            mined two blocks through height 961,633.
          </p>
          <p class="mt-4 text-sm text-muted-foreground">
            Checked against live chain data on August 9, 2026
          </p>
        </header>

        <aside
          class="mt-8 rounded-xl border border-destructive/35 bg-destructive/6 p-6"
          aria-labelledby="stop-first-title"
        >
          <h2 id="stop-first-title" class="text-lg font-semibold">
            Stop dependent services first
          </h2>
          <p class="mt-2 leading-7 text-muted-foreground">
            Stop mining, Lightning, Electrum servers, explorers, and other
            services that use this node. Do not send or receive funds until
            Bitcoin and all dependent services are fully synced again. Make a
            current wallet backup and a current Lightning channel backup.
          </p>
        </aside>

        <aside
          class="mt-8 rounded-xl border border-primary/30 bg-primary/5 p-6"
        >
          <h2 class="text-lg font-semibold">Invalidate only the first block</h2>
          <p class="mt-2 leading-7 text-muted-foreground">
            You do not need two <code class="font-mono text-sm text-foreground"
              >invalidateblock</code
            > calls. When you invalidate the BIP-110 block at height 961,632, Bitcoin
            Knots also invalidates its child at height 961,633.
          </p>
        </aside>

        <section class="mt-16 scroll-mt-24" id="instructions">
          <p
            class="mb-2 text-xs font-semibold uppercase tracking-[0.16em] text-muted-foreground"
          >
            Switching procedure
          </p>
          <h2 class="text-3xl font-bold">Choose your platform</h2>
          <p class="mt-4 max-w-3xl leading-7 text-muted-foreground">
            Use Bitcoin Knots <code class="font-mono text-sm text-foreground"
              >v29.3.knots20260507</code
            >. It is the last matching Knots release without RDTS. It can use
            the existing data directory.
          </p>

          <nav class="mt-6" aria-label="Platform instructions">
            <p
              class="text-xs font-semibold uppercase tracking-[0.16em] text-muted-foreground"
            >
              Table of contents
            </p>
            <ul class="mt-3 grid gap-3 sm:grid-cols-2 lg:grid-cols-3">
              <li>
                <a
                  href="#docker"
                  class="group flex items-center justify-between rounded-lg border border-border/60 bg-card px-4 py-3 text-sm font-semibold transition-colors hover:border-primary/40 hover:bg-primary/5 hover:text-primary focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-primary"
                >
                  Docker
                  <span aria-hidden="true" class="text-muted-foreground"
                    >→</span
                  >
                </a>
              </li>
              <li>
                <a
                  href="#startos"
                  class="group flex items-center justify-between rounded-lg border border-border/60 bg-card px-4 py-3 text-sm font-semibold transition-colors hover:border-primary/40 hover:bg-primary/5 hover:text-primary focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-primary"
                >
                  StartOS 0.4
                  <span aria-hidden="true" class="text-muted-foreground"
                    >→</span
                  >
                </a>
              </li>
              <li>
                <a
                  href="#startos-0351"
                  class="group flex items-center justify-between rounded-lg border border-border/60 bg-card px-4 py-3 text-sm font-semibold transition-colors hover:border-primary/40 hover:bg-primary/5 hover:text-primary focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-primary"
                >
                  StartOS 0.3.5.1
                  <span aria-hidden="true" class="text-muted-foreground"
                    >→</span
                  >
                </a>
              </li>
              <li>
                <a
                  href="#umbrel"
                  class="group flex items-center justify-between rounded-lg border border-border/60 bg-card px-4 py-3 text-sm font-semibold transition-colors hover:border-primary/40 hover:bg-primary/5 hover:text-primary focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-primary"
                >
                  Umbrel
                  <span aria-hidden="true" class="text-muted-foreground"
                    >→</span
                  >
                </a>
              </li>
              <li>
                <a
                  href="#mynode"
                  class="group flex items-center justify-between rounded-lg border border-border/60 bg-card px-4 py-3 text-sm font-semibold transition-colors hover:border-primary/40 hover:bg-primary/5 hover:text-primary focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-primary"
                >
                  myNode
                  <span aria-hidden="true" class="text-muted-foreground"
                    >→</span
                  >
                </a>
              </li>
              <li class="sm:col-span-2 lg:col-span-1">
                <a
                  href="#general"
                  class="group flex items-center justify-between rounded-lg border border-border/60 bg-card px-4 py-3 text-sm font-semibold transition-colors hover:border-primary/40 hover:bg-primary/5 hover:text-primary focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-primary"
                >
                  General Bitcoin Knots
                  <span aria-hidden="true" class="text-muted-foreground"
                    >→</span
                  >
                </a>
              </li>
            </ul>
          </nav>

          <aside
            class="mt-6 rounded-xl border border-primary/30 bg-primary/5 p-5"
          >
            <p class="font-semibold text-foreground">
              Keep using Bitcoin Knots
            </p>
            <p class="mt-2 leading-7 text-muted-foreground">
              You can keep using Bitcoin Knots for this switch. It must be a
              matching version from before RDTS so the existing Knots
              configuration, wallet, and index behavior stay compatible.
            </p>
          </aside>

          <div class="mt-8 space-y-6">
            <section
              id="docker"
              class="scroll-mt-24 rounded-xl border border-border/60 bg-card p-6"
              aria-labelledby="docker-heading"
            >
              <div class="flex flex-wrap items-center gap-3">
                <h3 id="docker-heading" class="text-xl font-semibold">
                  Docker
                </h3>
              </div>
              <p class="mt-5 leading-7 text-muted-foreground">
                Run these commands from the directory that contains your
                Compose file. The examples use <code
                  class="font-mono text-sm text-foreground">bitcoin</code
                > as the service and container name. Replace that name if your
                setup uses a different one.
              </p>
              <ol
                class="mt-5 list-decimal space-y-3 pl-5 leading-7 text-muted-foreground marker:font-semibold marker:text-foreground"
              >
                <li>
                  In <code class="font-mono text-sm text-foreground"
                    >docker-compose.yml</code
                  >, set the Bitcoin image to <code
                    class="break-all font-mono text-sm text-foreground"
                    >ghcr.io/retropex/bitcoin:29.3.knots20260507</code
                  >.
                </li>
                <li>
                  Keep the existing Bitcoin data volume mounted at <code
                    class="font-mono text-sm text-foreground"
                    >/data/.bitcoin</code
                  >. Do not create a new empty volume.
                </li>
                <li>
                  Remove <code class="font-mono text-sm text-foreground"
                    >consensusrules=rdts</code
                  > from <code class="font-mono text-sm text-foreground"
                    >bitcoin.conf</code
                  >. The pre-RDTS release will not start with that value.
                </li>
                <li>
                  Stop every container that depends on Bitcoin. Keep the
                  database and Bitcoin data volumes.
                </li>
              </ol>
              <div class="mt-5">
                <CodeBlock
                  code={dockerCheckCommands}
                  label="Inspect the current chain"
                />
              </div>
              <div class="mt-5">
                <CodeBlock
                  code={dockerRestartCommands}
                  label="Start pre-RDTS Bitcoin Knots"
                />
              </div>
              <p class="mt-5 leading-7 text-muted-foreground">
                Wait for Bitcoin Knots to accept RPC commands. If block 961,632
                still has the BIP-110 hash, invalidate the first BIP-110 block.
                This one call also invalidates its child at height 961,633.
              </p>
              <div class="mt-3">
                <CodeBlock
                  code={dockerInvalidateCommand}
                  label="Leave the BIP-110 branch"
                />
              </div>
              <p class="mt-5 text-sm leading-6 text-muted-foreground">
                After the final checks pass, clear the temporary local mark.
                Then start the dependent services.
              </p>
              <div class="mt-3">
                <CodeBlock
                  code={dockerFinishCommand}
                  label="Clear the temporary override"
                />
              </div>
              <p class="mt-3 text-sm leading-6 text-muted-foreground">
                Restart the dependent containers with your normal Compose
                command after their Bitcoin connection is ready.
              </p>
            </section>

            <section
              id="startos"
              class="scroll-mt-24 rounded-xl border border-border/60 bg-card p-6"
              aria-labelledby="startos-heading"
            >
              <div class="flex flex-wrap items-center gap-3">
                <h3 id="startos-heading" class="text-xl font-semibold">
                  StartOS 0.4
                </h3>
                <span
                  class="rounded-full border border-primary/30 bg-primary/6 px-2.5 py-1 text-xs font-medium text-primary"
                >
                  Automatic switch
                </span>
              </div>
              <ol
                class="mt-5 list-decimal space-y-3 pl-5 leading-7 text-muted-foreground marker:font-semibold marker:text-foreground"
              >
                <li>Stop the services that depend on Bitcoin Knots.</li>
                <li>
                  Refresh the StartOS marketplace. Then install the current <strong
                    class="text-foreground">Bitcoin Knots (pre-RDTS)</strong
                  > flavor.
                </li>
                <li>Start Bitcoin Knots and wait for chain sync.</li>
                <li>
                  If StartOS finds stored invalid-chain verdicts, it clears them
                  and shows a <strong class="text-foreground"
                    >Chain Verdicts Reset</strong
                  > notification. If it finds none, normal chain sync continues without
                  this notification.
                </li>
              </ol>
              <p class="mt-5 text-sm leading-6 text-muted-foreground">
                Do not run the manual invalidation command on StartOS unless
                StartOS reports a problem while it resets chain verdicts.
              </p>
            </section>

            <section
              id="startos-0351"
              class="scroll-mt-24 rounded-xl border border-border/60 bg-card p-6"
              aria-labelledby="startos-0351-heading"
            >
              <div class="flex flex-wrap items-center gap-3">
                <h3 id="startos-0351-heading" class="text-xl font-semibold">
                  StartOS 0.3.5.1
                </h3>
                <span
                  class="rounded-full border border-border/70 bg-muted/50 px-2.5 py-1 text-xs font-medium text-muted-foreground"
                >
                  Legacy package
                </span>
              </div>

              <aside
                class="mt-5 rounded-lg border border-destructive/30 bg-destructive/5 p-5"
              >
                <p class="font-semibold text-foreground">
                  Make a backup and do not uninstall
                </p>
                <p class="mt-2 leading-7 text-muted-foreground">
                  Open <strong class="text-foreground"
                    >System → Create Backup</strong
                  >. Select Bitcoin Knots, Lightning, and related services. Wait
                  for the backup to finish before you continue. Use a network
                  folder or an EXT4 physical drive. See the <a
                    href="https://docs.start9.com/0.3.5.x/user-manual/backups/backup-create.html"
                    target="_blank"
                    rel="noopener noreferrer"
                    class="font-medium text-primary hover:underline"
                    >StartOS 0.3.5.1 backup guide</a
                  >. If you cannot complete the backup, do not continue. The
                  Bitcoin Knots backup omits the blockchain, chainstate, and
                  indexes, so a restore can require a blockchain resync.
                </p>
                <p class="mt-3 text-sm leading-6 text-muted-foreground">
                  Do not uninstall Bitcoin Knots. The update uses the existing <code
                    class="font-mono text-xs text-foreground">bitcoind</code
                  > service and keeps its data volume.
                </p>
              </aside>

              <p class="mt-5 leading-7 text-muted-foreground">
                The current marketplace package requires StartOS 0.4. StartOS
                0.3.5.1 needs the older <code
                  class="font-mono text-sm text-foreground">.s9pk</code
                > package format. The linked package contains Bitcoin Knots from before
                RDTS and supports both Start9 processor types. It is a community package
                from Retropex, not an official Start9 release.
              </p>

              <ol
                class="mt-5 list-decimal space-y-3 pl-5 leading-7 text-muted-foreground marker:font-semibold marker:text-foreground"
              >
                <li>
                  Download <a
                    href="https://github.com/Retropex/knots-startos/releases/download/v29.3.knots20260507/bitcoind.s9pk"
                    class="font-medium text-primary hover:underline"
                    >bitcoind.s9pk</a
                  > from the <a
                    href="https://github.com/Retropex/knots-startos/releases/tag/v29.3.knots20260507"
                    target="_blank"
                    rel="noopener noreferrer"
                    class="font-medium text-primary hover:underline"
                    >v29.3.knots20260507 release</a
                  >.
                </li>
                <li>
                  Check that its SHA-256 value is <code
                    class="break-all font-mono text-xs text-foreground"
                    >3a57a796c5f211d810b44ee9e948ca84ac985fcca5af586f1ae1272c2f23f1dc</code
                  >.
                </li>
                <li>Stop all services that depend on Bitcoin Knots.</li>
                <li>Stop Bitcoin Knots.</li>
                <li>
                  Open <strong class="text-foreground"
                    >System → Sideload Service</strong
                  >, select <code class="font-mono text-sm text-foreground"
                    >bitcoind.s9pk</code
                  >, and select <strong class="text-foreground"
                    >Upload &amp; Install</strong
                  >. Install it as an update to the existing service.
                </li>
                <li>
                  Open Bitcoin Knots. Select <strong class="text-foreground"
                    >Configure</strong
                  >, save the configuration, and start the service.
                </li>
                <li>Wait for Bitcoin Knots to accept RPC commands.</li>
              </ol>

              <div class="mt-5">
                <CodeBlock
                  code={startOsLegacyChecksumCommand}
                  label="Check the downloaded package"
                />
              </div>

              <p class="mt-5 leading-7 text-muted-foreground">
                The legacy package does not switch chains automatically. If
                the node does not resume sync, connect to StartOS with SSH.
                Replace the example hostname with the name of your server. The
                SSH user is <code class="font-mono text-sm text-foreground"
                  >start9</code
                >, not <code class="font-mono text-sm text-foreground"
                  >root</code
                >. See the <a
                  href="https://docs.start9.com/0.3.5.x/user-manual/ssh/"
                  target="_blank"
                  rel="noopener noreferrer"
                  class="font-medium text-primary hover:underline"
                  >StartOS SSH guide</a
                > if SSH is not set up.
              </p>
              <div class="mt-3">
                <CodeBlock
                  code={startOsLegacySshCommand}
                  label="Connect to StartOS"
                />
              </div>
              <div class="mt-3">
                <CodeBlock
                  code={startOsLegacyCheckCommands}
                  label="Check the active chain"
                />
              </div>
              <p class="mt-5 leading-7 text-muted-foreground">
                If block 961,632 has the BIP-110 hash, invalidate its
                first block. This one call also invalidates its child at height
                961,633.
              </p>
              <div class="mt-3">
                <CodeBlock
                  code={startOsLegacyInvalidateCommand}
                  label="Leave the BIP-110 branch"
                />
              </div>
              <p class="mt-5 text-sm leading-6 text-muted-foreground">
                Complete the final checks below. If you used the invalidation
                command, clear the temporary mark only after the node is fully
                synced on the Core chain.
              </p>
              <div class="mt-3">
                <CodeBlock
                  code={startOsLegacyFinishCommand}
                  label="Clear the temporary override after sync"
                />
              </div>
            </section>

            <section
              id="umbrel"
              class="scroll-mt-24 rounded-xl border border-border/60 bg-card p-6"
              aria-labelledby="umbrel-heading"
            >
              <div class="flex items-center gap-3">
                <h3 id="umbrel-heading" class="text-xl font-semibold">
                  Umbrel
                </h3>
              </div>
              <ol
                class="mt-5 list-decimal space-y-3 pl-5 leading-7 text-muted-foreground marker:font-semibold marker:text-foreground"
              >
                <li>Stop apps that depend on Bitcoin Knots.</li>
                <li>
                  Open <strong class="text-foreground"
                    >Bitcoin Knots → Settings → Version</strong
                  >.
                </li>
                <li>
                  Select <strong class="font-mono text-sm text-foreground"
                    >v29.3.knots20260507</strong
                  >, save the setting, and wait for the node to restart.
                </li>
                <li>Open the umbrelOS terminal and check the active chain.</li>
              </ol>
              <div class="mt-5">
                <CodeBlock code={umbrelCheckCommands} label="Check the chain" />
              </div>
              <p class="mt-5 leading-7 text-muted-foreground">
                If the node stays on the BIP-110 block at height 961,633, run
                this one command:
              </p>
              <div class="mt-3">
                <CodeBlock
                  code={umbrelInvalidateCommand}
                  label="Leave the BIP-110 branch"
                />
              </div>
            </section>

            <section
              id="mynode"
              class="scroll-mt-24 rounded-xl border border-border/60 bg-card p-6"
              aria-labelledby="mynode-heading"
            >
              <div class="flex items-center gap-3">
                <h3 id="mynode-heading" class="text-xl font-semibold">
                  myNode
                </h3>
              </div>
              <ol
                class="mt-5 list-decimal space-y-3 pl-5 leading-7 text-muted-foreground marker:font-semibold marker:text-foreground"
              >
                <li>Stop services that depend on Bitcoin.</li>
                <li>
                  Open <strong class="text-foreground"
                    >Settings → Custom Bitcoin Version</strong
                  >.
                </li>
                <li>
                  Select <strong class="text-foreground"
                    >Bitcoin Knots (v29.3.knots20260507)</strong
                  > and wait for the installation and restart.
                </li>
                <li>Open the Bitcoin CLI web terminal and check the chain.</li>
              </ol>
              <div class="mt-5">
                <CodeBlock code={myNodeCheckCommands} label="Check the chain" />
              </div>
              <p class="mt-5 leading-7 text-muted-foreground">
                If the node stays on the BIP-110 block at height 961,633, run
                this one command:
              </p>
              <div class="mt-3">
                <CodeBlock
                  code={myNodeInvalidateCommand}
                  label="Leave the BIP-110 branch"
                />
              </div>
            </section>

            <section
              id="general"
              class="scroll-mt-24 rounded-xl border border-border/60 bg-card p-6"
              aria-labelledby="general-heading"
            >
              <div class="flex items-center gap-3">
                <h3 id="general-heading" class="text-xl font-semibold">
                  General Bitcoin Knots
                </h3>
              </div>
              <ol
                class="mt-5 list-decimal space-y-3 pl-5 leading-7 text-muted-foreground marker:font-semibold marker:text-foreground"
              >
                <li>Stop <code class="font-mono text-sm">bitcoind</code>.</li>
                <li>Back up the wallet and configuration files.</li>
                <li>
                  Remove <code class="font-mono text-sm text-foreground"
                    >consensusrules=rdts</code
                  > from <code class="font-mono text-sm text-foreground"
                    >bitcoin.conf</code
                  >. The pre-RDTS release does not start when this value is
                  present.
                </li>
                <li>
                  Download and verify <a
                    href="https://github.com/bitcoinknots/bitcoin/releases/tag/v29.3.knots20260507"
                    target="_blank"
                    rel="noopener noreferrer"
                    class="font-medium text-primary hover:underline"
                    >Bitcoin Knots v29.3.knots20260507</a
                  >. Install it without changing the data directory.
                </li>
                <li>Start the node and check the active chain.</li>
              </ol>
              <div class="mt-5">
                <CodeBlock code={checkCommands} label="Check the chain" />
              </div>
              <p class="mt-5 leading-7 text-muted-foreground">
                If the node stays on the BIP-110 block at height 961,633, run
                this one command:
              </p>
              <div class="mt-3">
                <CodeBlock
                  code={invalidateCommand}
                  label="Leave the BIP-110 branch"
                />
              </div>
            </section>
          </div>
        </section>

        <section class="mt-16" aria-labelledby="verify-heading">
          <p
            class="mb-2 text-xs font-semibold uppercase tracking-[0.16em] text-muted-foreground"
          >
            Final checks
          </p>
          <h2 id="verify-heading" class="text-3xl font-bold">
            Verify before you restart other services
          </h2>
          <p class="mt-4 leading-7 text-muted-foreground">
            Wait for peers to send the Core chain. Then run these commands
            with the command prefix for your platform.
          </p>
          <div class="mt-5">
            <CodeBlock code={verifyCommands} label="Verify chain and sync" />
          </div>

          <div class="mt-6 grid gap-4 sm:grid-cols-3">
            <div class="rounded-lg border border-border/60 bg-card p-4">
              <p class="text-sm font-semibold">Block 961,632</p>
              <p class="mt-2 break-all font-mono text-xs text-primary">
                {bitcoinFirstBlock}
              </p>
            </div>
            <div class="rounded-lg border border-border/60 bg-card p-4">
              <p class="text-sm font-semibold">Sync state</p>
              <p class="mt-2 text-sm leading-6 text-muted-foreground">
                <code class="font-mono text-xs">blocks</code> equals <code
                  class="font-mono text-xs">headers</code
                > and <code class="font-mono text-xs">initialblockdownload</code
                > is <code class="font-mono text-xs">false</code>.
              </p>
            </div>
            <div class="rounded-lg border border-border/60 bg-card p-4">
              <p class="text-sm font-semibold">Dependent services</p>
              <p class="mt-2 text-sm leading-6 text-muted-foreground">
                Wait for each index and Lightning service to report full sync.
              </p>
            </div>
          </div>
        </section>

        <section
          class="mt-12 rounded-xl border border-border/60 bg-muted/30 p-6"
          aria-labelledby="cleanup-heading"
        >
          <h2 id="cleanup-heading" class="text-xl font-semibold">
            Remove the temporary local override
          </h2>
          <p class="mt-3 leading-7 text-muted-foreground">
            Do this only if you ran <code
              class="font-mono text-sm text-foreground">invalidateblock</code
            > and all final checks pass. This command removes the permanent local
            invalid mark. After the command, verify that the node remains on the
            Core chain.
          </p>
          <p class="mt-3 text-sm leading-6 text-muted-foreground">
            Use the same platform command as above. Replace
            <code class="font-mono text-xs">invalidateblock</code> with
            <code class="font-mono text-xs">reconsiderblock</code>.
          </p>
          <div class="mt-4">
            <CodeBlock
              code={reconsiderCommand}
              label="Run only after full sync"
            />
          </div>
          <p class="mt-4 text-sm leading-6 text-muted-foreground">
            Run <code class="font-mono text-xs">getblockhash 961632</code> one more
            time. It must still show the block hash shown above for the Core
            chain.
          </p>
        </section>

        <section class="mt-16 border-t border-border/60 pt-10">
          <h2 class="text-2xl font-bold">Do not start with a reindex</h2>
          <ul class="mt-5 space-y-3 leading-7 text-muted-foreground">
            <li>
              • A normal switch keeps the existing blocks and chainstate. It
              does not need a download from genesis.
            </li>
            <li>
              • <code class="font-mono text-sm">-reindex-chainstate</code> does not
              change the consensus rules and is not a chain selector.
            </li>
            <li>
              • Use a full reindex only if the node reports damaged block-index
              data, or if a platform tool says that pruned data makes an
              in-place switch impossible.
            </li>
          </ul>
        </section>

        <nav
          aria-label="Verification links"
          class="mt-16 border-y border-border/60 py-6"
        >
          <p class="text-sm font-semibold">Check the procedure</p>
          <div class="mt-3 flex flex-wrap gap-x-6 gap-y-3 text-sm">
            <a
              href="https://github.com/bitcoinknots/bitcoin/blob/v29.3.knots20260507/src/rpc/blockchain.cpp"
              target="_blank"
              rel="noopener noreferrer"
              class="text-primary hover:underline">Bitcoin Knots RPC behavior</a
            >
            <a
              href="https://github.com/Start9Labs/bitcoin-knots-startos#switching-flavors-during-a-chain-split"
              target="_blank"
              rel="noopener noreferrer"
              class="text-primary hover:underline"
              >StartOS automatic chain switch</a
            >
            <a
              href="https://github.com/Retropex/knots-startos/releases/tag/v29.3.knots20260507"
              target="_blank"
              rel="noopener noreferrer"
              class="text-primary hover:underline"
              >StartOS 0.3.5.1 pre-RDTS package</a
            >
            <a
              href="https://docs.start9.com/0.3.5.x/user-manual/backups/backup-create.html"
              target="_blank"
              rel="noopener noreferrer"
              class="text-primary hover:underline"
              >StartOS 0.3.5.1 backup guide</a
            >
            <a
              href="https://docs.start9.com/0.3.5.x/user-manual/ssh/"
              target="_blank"
              rel="noopener noreferrer"
              class="text-primary hover:underline">StartOS SSH guide</a
            >
            <a
              href="https://github.com/Retropex/umbrel-bitcoin/blob/master/libs/settings/settings.meta.ts"
              target="_blank"
              rel="noopener noreferrer"
              class="text-primary hover:underline">Umbrel version selector</a
            >
            <a
              href="https://github.com/mynodebtc/mynode/blob/master/rootfs/standard/var/www/mynode/templates/settings.html"
              target="_blank"
              rel="noopener noreferrer"
              class="text-primary hover:underline">myNode version selector</a
            >
          </div>
        </nav>
      </div>
    </article>

    <Footer />
  </main>
</Layout>
