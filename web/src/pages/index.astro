---
import Layout from "@/layouts/Layout.astro";
import Header from "@/components/Header.astro";
import HeroSection from "@/components/HeroSection.astro";
import KeyPoints from "@/components/KeyPoints.astro";
import SupportSection from "@/components/SupportSection.astro";
import ProblemSection from "@/components/ProblemSection.astro";
import { make as HowItWorks } from "@/components/HowItWorks.res.js";
import { make as FAQ } from "@/components/FAQ.res.js";
import Timeline from "@/components/Timeline.astro";
import Articles from "@/components/Articles.astro";
import Tradeoffs from "@/components/Tradeoffs.astro";
import Footer from "@/components/Footer.astro";
import { make as MonitorHighlights } from "@/components/MonitorHighlights.res.js";
---

<Layout
  title="BIP-110: Temporarily Limit Arbitrary Data in Bitcoin"
  description="A one-year consensus soft fork to limit arbitrary data storage in Bitcoin, protecting its purpose as sound, permissionless money."
  ogImage="/og.jpg"
>
  <main>
    <Header />
    <HeroSection />
    <KeyPoints />
    <SupportSection />
    <MonitorHighlights client:load />
    <ProblemSection />
    <HowItWorks client:load />
    <FAQ client:load />
    <Articles />
    <Tradeoffs />
    <Timeline />
    <Footer />
  </main>
</Layout>
