---
import Layout from "@/layouts/Layout.astro";
import Header from "@/components/Header.astro";
import HeroSection from "@/components/HeroSection.astro";
import KeyPoints from "@/components/KeyPoints.astro";
import SupportSection from "@/components/SupportSection.astro";
import ProblemSection from "@/components/ProblemSection.astro";
import { HowItWorks } from "@/components/HowItWorks";
import { FAQ } from "@/components/FAQ";
import Timeline from "@/components/Timeline.astro";
import Articles from "@/components/Articles.astro";
import Tradeoffs from "@/components/Tradeoffs.astro";
import Footer from "@/components/Footer.astro";
import { MonitorHighlights } from "@/components/MonitorDashboard";
---

<Layout
  title="BIP-110: Temporarily Limit Arbitrary Data in Bitcoin"
  description="A one-year consensus soft fork to limit arbitrary data storage in Bitcoin, protecting its purpose as sound, permissionless money."
  ogImage="/og.jpg"
>
  <main>
    <Header />
    <HeroSection />
    <KeyPoints />
    <SupportSection />
    <MonitorHighlights client:visible />
    <ProblemSection />
    <HowItWorks client:visible />
    <FAQ client:visible />
    <Articles />
    <Tradeoffs />
    <Timeline />
    <Footer />
  </main>
</Layout>
