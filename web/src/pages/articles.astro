---
import Layout from "@/layouts/Layout.astro";
import Header from "@/components/Header.astro";
import Footer from "@/components/Footer.astro";
import ArticleCard from "@/components/ArticleCard.astro";
import { articleSections } from "@/lib/content";

const articleSectionLinks = articleSections.map((section) => ({
  ...section,
  id: section.title
    .toLowerCase()
    .replace(/[^a-z0-9]+/g, "-")
    .replace(/(^-|-$)/g, ""),
}));
---

<Layout
  title="Articles on BIP-110: In-Depth Reading on Bitcoin's Future"
  description="Start with the context behind Bitcoin's arbitrary data problem, then read the game theory, legal analysis, and technical audits of BIP-110."
  ogImage="/images/bip110-og-articles-dark.png"
>
  <main class="min-h-screen">
    <Header />

    <section class="pt-24 pb-24 px-6">
      <div class="max-w-4xl mx-auto">
        <h1 class="text-4xl font-bold mb-4">Articles</h1>
        <p class="text-xl text-muted-foreground mb-16 max-w-3xl">
          Start with the context behind Bitcoin's arbitrary data problem, then
          move into the <span class="whitespace-nowrap">BIP-110</span> proposal and
          its tradeoffs.
        </p>

        <nav
          aria-labelledby="article-toc-heading"
          class="mb-16 border-y border-border/60 py-5"
        >
          <h2
            id="article-toc-heading"
            class="mb-4 text-sm font-semibold uppercase tracking-wide text-muted-foreground"
          >
            Table of contents
          </h2>
          <ul class="grid gap-3 sm:grid-cols-3">
            {
              articleSectionLinks.map((section) => (
                <li>
                  <a
                    href={`#${section.id}`}
                    class="group block rounded-md px-3 py-2 transition-colors hover:bg-primary/10"
                  >
                    <span class="block font-semibold transition-colors group-hover:text-primary">
                      {section.title}
                    </span>
                    <span class="mt-1 block text-sm text-muted-foreground">
                      {section.articles.length === 1
                        ? "1 article"
                        : `${section.articles.length} articles`}
                    </span>
                  </a>
                </li>
              ))
            }
          </ul>
        </nav>

        <div class="space-y-20">
          {
            articleSectionLinks.map((section) => (
              <section aria-labelledby={section.id} class="scroll-mt-24">
                <div class="mb-8 max-w-2xl">
                  <h2 id={section.id} class="text-2xl font-bold mb-2">
                    {section.title}
                  </h2>
                  <p class="text-muted-foreground">{section.description}</p>
                </div>

                <div class="grid gap-6 md:grid-cols-2">
                  {section.articles.map((article) => (
                    <ArticleCard article={article} />
                  ))}
                </div>
              </section>
            ))
          }
        </div>
      </div>
    </section>

    <Footer />
  </main>
</Layout>
