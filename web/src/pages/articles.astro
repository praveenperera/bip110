---
import Layout from "@/layouts/Layout.astro";
import Header from "@/components/Header.astro";
import Footer from "@/components/Footer.astro";
import ArticleCard from "@/components/ArticleCard.astro";
import { articleSections } from "@/lib/content";

const articleSectionLinks = articleSections.map((section) => ({
  ...section,
  id: section.title
    .toLowerCase()
    .replace(/[^a-z0-9]+/g, "-")
    .replace(/(^-|-$)/g, ""),
}));

const articleCountLabel = (count: number) =>
  count === 1 ? "1 article" : `${count} articles`;

const articleGridClass = (count: number) =>
  count === 1 ? "grid gap-6 md:max-w-xl" : "grid gap-6 md:grid-cols-2";
---

<Layout
  title="Articles on BIP-110: In-Depth Reading on Bitcoin's Future"
  description="Start with the context behind Bitcoin's arbitrary data problem, then read the game theory, legal analysis, and technical audits of BIP-110."
  ogImage="/images/bip110-og-articles-dark.png"
>
  <main class="min-h-screen">
    <Header />

    <section class="pt-24 pb-24 px-6">
      <div class="max-w-4xl mx-auto">
        <h1 class="text-4xl font-bold mb-4">Articles</h1>
        <p class="text-xl text-muted-foreground mb-16 max-w-3xl">
          Start with the context behind Bitcoin's arbitrary data problem, then
          move into the <span class="whitespace-nowrap">BIP-110</span> proposal and
          its tradeoffs.
        </p>

        <nav
          aria-labelledby="article-toc-heading"
          class="mb-16 border-y border-border/60"
        >
          <h2
            id="article-toc-heading"
            class="border-b border-border/50 py-4 text-sm font-semibold uppercase tracking-wide text-muted-foreground"
          >
            Sections
          </h2>
          <ul class="divide-y divide-border/60">
            {
              articleSectionLinks.map((section) => (
                <li>
                  <a
                    href={`#${section.id}`}
                    class="group relative flex items-center justify-between gap-6 rounded-md py-4 outline-none transition-colors focus-visible:ring-[3px] focus-visible:ring-ring/40"
                  >
                    <span class="flex min-w-0 items-center gap-3">
                      <span
                        aria-hidden="true"
                        class="h-1.5 w-1.5 shrink-0 rounded-full bg-border transition-colors group-hover:bg-primary group-focus-visible:bg-primary"
                      />
                      <span class="block truncate font-semibold">
                        {section.title}
                      </span>
                    </span>
                    <span class="shrink-0 text-sm text-muted-foreground transition-colors group-hover:text-foreground group-focus-visible:text-foreground">
                      {articleCountLabel(section.articles.length)}
                    </span>
                    <span
                      aria-hidden="true"
                      class="absolute bottom-0 left-0 h-px w-12 bg-primary opacity-0 transition-opacity group-hover:opacity-100 group-focus-visible:opacity-100"
                    />
                  </a>
                </li>
              ))
            }
          </ul>
        </nav>

        <div class="space-y-16">
          {
            articleSectionLinks.map((section) => (
              <section
                id={section.id}
                aria-labelledby={`${section.id}-heading`}
                class="scroll-mt-24 border-t border-border/60 pt-12"
              >
                <div class="mb-8 max-w-2xl">
                  <div aria-hidden="true" class="mb-5 h-px w-10 bg-primary" />
                  <h2 class="group mb-2 flex items-center gap-2 text-2xl font-bold">
                    <span id={`${section.id}-heading`}>{section.title}</span>
                    <a
                      href={`#${section.id}`}
                      aria-label={`Link to ${section.title} section`}
                      class="text-muted-foreground opacity-0 outline-none transition-opacity hover:text-foreground group-hover:opacity-100 focus-visible:opacity-100 focus-visible:ring-[3px] focus-visible:ring-ring/40"
                    >
                      #
                    </a>
                  </h2>
                  <p class="text-muted-foreground">{section.description}</p>
                </div>

                <div class={articleGridClass(section.articles.length)}>
                  {section.articles.map((article) => (
                    <ArticleCard article={article} />
                  ))}
                </div>
              </section>
            ))
          }
        </div>
      </div>
    </section>

    <Footer />
  </main>
</Layout>
