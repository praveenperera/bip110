---
import ComparisonTable from "@/components/responses/ComparisonTable.astro";
import CodeBlock from "@/components/responses/CodeBlock.astro";
import Footer from "@/components/Footer.astro";
import Header from "@/components/Header.astro";
import Layout from "@/layouts/Layout.astro";
import { opPlentyResponse as response } from "@/lib/content";

const source = response.claim.source;

const tableColumns = [
  { key: "method", label: "Method" },
  { key: "role", label: "Role" },
  { key: "disk", label: "Bytes on disk" },
  { key: "recovery", label: "Recovery" },
  { key: "weight", label: "Payload floor", mono: true },
  { key: "bip110", label: "Under BIP-110" },
] as const;

const tableRows = [
  {
    method: "OP_RETURN",
    role: "Explicit, bounded metadata outlet",
    disk: "Payload bytes are verbatim",
    recovery: "Parse the output script",
    weight: "≈4 WU/byte",
    bip110: "Valid within an 83-byte script cap",
  },
  {
    method: "Inscription envelope",
    role: "Spend-path data workaround",
    disk: "Payload bytes are verbatim inside pushes; framing can interrupt chunks",
    recovery:
      "Parse the envelope and pushes; file signatures remain recognizable",
    weight: "≈1 WU/byte",
    bip110: "Large pushes are capped and Tapscript OP_IF/OP_NOTIF is rejected",
  },
  {
    method: "OP_PLENTY",
    role: "Executed-opcode steganography",
    disk: "Two transformed opcode bytes replace each payload byte",
    recovery: "Know the scheme and run its modulo-22 decoder",
    weight: "≈2 WU/byte",
    bip110: "The published construction appears valid",
  },
] as const;

const toc = [
  { id: "construction", label: "How OP_PLENTY encodes data" },
  { id: "op-return", label: "OP_RETURN defines supported data" },
  { id: "inscriptions", label: "OP_PLENTY repeats the inscription trick" },
  { id: "on-disk", label: "What a node stores on disk" },
  { id: "cost", label: "The cost and recovery comparison" },
  { id: "standard", label: "An impossible standard" },
] as const;
---

<Layout
  title={`${response.title} | BIP-110`}
  description={response.description}
  ogImage="/images/bip110-og-op-plenty-dark.png"
  ogImageWidth="2400"
  ogImageHeight="1260"
  ogImageAlt="OP_PLENTY fails as a critique of BIP-110. Two script bytes per payload byte, plus a protocol-specific decoder."
>
  <main class="min-h-screen">
    <Header />

    <article class="px-6 pb-24 pt-24">
      <div class="mx-auto max-w-4xl">
        <header class="mb-14 border-b border-border/60 pb-10">
          <p
            class="mb-4 text-xs font-semibold uppercase tracking-[0.16em] text-primary"
          >
            Response
          </p>
          <h1 class="max-w-3xl text-4xl font-bold tracking-tight sm:text-5xl">
            {response.title}
          </h1>
          <p class="mt-6 max-w-3xl text-xl leading-8 text-muted-foreground">
            A close look at what hiding arbitrary data in executable script
            actually costs.
          </p>
          <div
            class="mt-6 flex flex-wrap items-center gap-x-3 gap-y-2 text-sm text-muted-foreground"
          >
            <span>{response.author}</span>
            <span aria-hidden="true">•</span>
            <time datetime={response.dateIso}>{response.date}</time>
            <span aria-hidden="true">•</span>
            <a
              href={source.url}
              target="_blank"
              rel="noopener noreferrer"
              class="transition-colors hover:text-foreground hover:underline"
            >
              Source: {source.name} by {source.author}
            </a>
          </div>
        </header>

        <aside
          class="mb-8 rounded-xl border border-primary/30 bg-primary/5 p-6"
        >
          <p
            class="mb-2 text-xs font-semibold uppercase tracking-wide text-primary"
          >
            The argument
          </p>
          <p class="text-lg leading-8">{response.claim.statement}</p>
        </aside>

        <p class="mb-12 text-xl font-medium leading-8">
          OP_PLENTY is a genuinely clever construction attached to a weak
          argument. It hides payload bits in the choice between valid opcodes,
          which is exactly the kind of steganography BIP-110 already
          anticipates. Showing that covert encoding is possible does nothing to
          show that the limits are ineffective.
        </p>

        <section
          aria-label="Response summary"
          class="mb-14 grid gap-4 md:grid-cols-2"
        >
          <div class="rounded-xl border border-border/60 bg-card/50 p-5">
            <p
              class="mb-2 text-xs font-semibold uppercase tracking-wide text-muted-foreground"
            >
              Technical finding
            </p>
            <p class="leading-7">
              The published encoder looks consensus-valid under BIP-110, and the
              decoder really does recover arbitrary payload bytes from the
              opcode stream.
            </p>
          </div>
          <div class="rounded-xl border border-primary/30 bg-primary/5 p-5">
            <p
              class="mb-2 text-xs font-semibold uppercase tracking-wide text-primary"
            >
              The category error
            </p>
            <p class="leading-7">
              The critique treats a custom cipher buried in executable script as
              if it were the same thing as Bitcoin's standardized field for
              arbitrary data.
            </p>
          </div>
        </section>

        <nav
          aria-labelledby="response-toc-heading"
          class="mb-16 border-y border-border/60"
        >
          <h2
            id="response-toc-heading"
            class="border-b border-border/50 py-4 text-sm font-semibold uppercase tracking-wide text-muted-foreground"
          >
            In this response
          </h2>
          <ol class="divide-y divide-border/60">
            {
              toc.map((item, index) => (
                <li>
                  <a
                    href={`#${item.id}`}
                    class="group flex items-center gap-4 rounded-md py-4 outline-none transition-colors hover:text-primary focus-visible:ring-[3px] focus-visible:ring-ring/40"
                  >
                    <span class="font-mono text-xs text-muted-foreground">
                      {String(index + 1).padStart(2, "0")}
                    </span>
                    <span class="font-semibold">{item.label}</span>
                  </a>
                </li>
              ))
            }
          </ol>
        </nav>

        <div class="space-y-16">
          <section id="construction" class="scroll-mt-24">
            <h2 class="mb-5 text-3xl font-bold">How OP_PLENTY encodes data</h2>
            <div class="space-y-5 text-lg leading-8 text-muted-foreground">
              <p>
                OP_PLENTY splits every payload byte into two nibbles, then picks
                a Tapscript opcode for each nibble so that the opcode number
                modulo 22 gives the value back. A small state machine keeps the
                scratch stack valid while those opcodes execute.
              </p>
              <p>
                Every payload byte ends up costing two script bytes. The
                optional v2 framing adds seven <code
                  class="font-mono text-sm text-foreground">OP_5</code
                >{" "}
                opcodes as a searchable marker plus eight more for the encoded length.
                Skip the framing and the receiver has to learn the script boundary
                or raw-transaction offset some other way.
              </p>
            </div>

            <div class="mt-8 grid gap-5 lg:grid-cols-2">
              <CodeBlock
                label='Published worked example: b"Hi"'
                code={`0x48 -> nibbles (4, 8)\n0x69 -> nibbles (6, 9)\n\nencoded body: 9e 60 a0 61`}
                href={source.url}
              />
              <CodeBlock
                label="The separate payload decoder"
                code={`payload_hex = "".join(\n    f"{op % 22:x}" for op in payload\n)`}
                language="python"
                href={source.url}
              />
            </div>

            <p class="mt-6 text-lg leading-8 text-muted-foreground">
              Bitcoin validates the Tapscript and stops there. Getting the
              payload back takes external software running the modulo-22
              decoder.
            </p>
          </section>

          <section id="op-return" class="scroll-mt-24">
            <h2 class="mb-5 text-3xl font-bold">
              OP_RETURN defines supported data
            </h2>
            <div class="space-y-5 text-lg leading-8 text-muted-foreground">
              <p>
                OP_RETURN is where Bitcoin explicitly makes room for small
                amounts of arbitrary metadata. BIP-110 keeps that outlet and
                caps the whole output script at 83 bytes. The cap is a statement
                about how much explicit data Bitcoin supports; nobody claims it
                closes every covert channel, because in a programmable system
                nothing can.
              </p>
              <p>
                Raising or removing the OP_RETURN limit would expand a defined,
                recognizable, relayable interface for arbitrary data, and
                software accepting a larger standardized carrier would be
                supporting more of that use. Whether someone can hide bits in
                opcode choices has no bearing on where that explicit boundary
                should sit.
              </p>
            </div>
          </section>

          <section id="inscriptions" class="scroll-mt-24">
            <h2 class="mb-5 text-3xl font-bold">
              OP_PLENTY repeats the inscription trick
            </h2>
            <div class="space-y-5 text-lg leading-8 text-muted-foreground">
              <p>
                Inscriptions repurpose a Tapscript envelope and its data pushes.
                OP_PLENTY repurposes the choice of executed opcodes. Different
                syntax, same move: both turn spend-path machinery into a carrier
                for a payload that has nothing to do with the spending
                condition.
              </p>
              <p>
                Swapping data pushes for opcode choices is still steganography,
                just with different symbols. Signatures, public keys, input
                ordering, and scripts all have spare degrees of freedom that can
                carry outside bits.
              </p>
              <p class="font-medium text-foreground">
                Steganography will always be possible. Arguing from that fact to
                an unlimited explicit data carrier is the category error.
              </p>
            </div>
          </section>

          <section id="on-disk" class="scroll-mt-24">
            <h2 class="mb-5 text-3xl font-bold">What a node stores on disk</h2>
            <div class="space-y-5 text-lg leading-8 text-muted-foreground">
              <p>
                A full node stores the serialized transaction, Tapleaf script
                included. With an ordinary inscription, the payload bytes sit
                verbatim inside script pushes. Push framing can break up a long
                file, but recognizable signatures such as the PNG magic still
                show up in the block data.
              </p>
              <p>
                With OP_PLENTY, what hits the disk is the selected opcodes. The
                PNG signature itself never appears. Getting the file back means
                knowing OP_PLENTY's mapping and deliberately running its
                decoder.
              </p>
            </div>

            <div class="mt-8 grid gap-5">
              <CodeBlock label="PNG signature" code="89 50 4e 47 0d 0a 1a 0a" />
              <CodeBlock
                label="OP_PLENTY payload opcodes for the same eight bytes"
                code="a2 61 5d 9a 5c 92 9e 5f 9a 91 58 a4 59 a4 58 a4"
              />
            </div>

            <p class="mt-5 text-sm leading-6 text-muted-foreground">
              The second block shows the payload body only, without the
              optional v2 framing.
            </p>

            <div
              class="mt-8 rounded-xl border border-primary/30 bg-primary/5 p-6"
            >
              <p class="font-semibold">Bitcoin stops at script validation</p>
              <p class="mt-2 leading-7 text-muted-foreground">
                A BIP-110 node knows what each Tapscript opcode does, and that
                is where its job ends. The payload only exists once an outside
                protocol maps
                {" "}<code class="font-mono text-xs text-foreground"
                  >opcode % 22</code
                >{" "}
                to a nibble. If a byte string counts as everything some imaginable
                decoder could derive from it, “stored on the node” stops meaning anything.
              </p>
            </div>
          </section>

          <section id="cost" class="scroll-mt-24">
            <h2 class="mb-5 text-3xl font-bold">
              The cost and recovery comparison
            </h2>
            <p class="mb-8 text-lg leading-8 text-muted-foreground">
              All three mechanisms put bytes in transactions, but that is where
              the similarity ends. The interface, visibility, and cost differ
              a lot.
            </p>

            <ComparisonTable
              caption="Explicit carriers and steganographic workarounds"
              columns={tableColumns}
              rows={tableRows}
            />

            <p class="mt-5 text-sm leading-6 text-muted-foreground">
              Weight figures are payload-byte floors before transaction,
              framing, commitment, reveal, authorization, and other fixed
              overhead. OP_RETURN lives in non-witness transaction data;
              inscription and OP_PLENTY script bytes receive witness weighting.
            </p>

            <p class="mt-6 text-lg leading-8 text-muted-foreground">
              The optional OP_PLENTY v2 format shows the tradeoff nicely. The
              seven-<code class="font-mono text-sm text-foreground"
                >OP_5</code
              >{" "}
              marker makes the payload easy to find, and dropping it means the
              recipient has to get the script's location some other way.
            </p>
          </section>

          <section id="standard" class="scroll-mt-24">
            <h2 class="mb-5 text-3xl font-bold">An impossible standard</h2>
            <div class="space-y-5 text-lg leading-8 text-muted-foreground">
              <p>
                If the bar for BIP-110 is preventing every possible encoding,
                then every limit fails by definition, because no
                general-purpose programmable ledger can clear that bar. A test
                everything fails tells you nothing about whether a limit
                actually reduces the arbitrary data Bitcoin supports.
              </p>
              <p>
                BIP-110 keeps the explicit data outlet bounded, closes the
                cheapest standardized bulk paths, and makes workarounds less
                direct, less legible, and more expensive. The site's
                {" "}<a
                  href="/#wont-spammers-just-spread-their-data-over-multiple-fields"
                  class="text-primary hover:underline"
                >
                  steganography answer
                </a>{" "}
                already makes this point.
              </p>
            </div>

            <div
              class="mt-8 rounded-xl border border-primary/30 bg-primary/5 p-6 sm:p-8"
            >
              <p class="text-xl font-bold leading-8 text-foreground">
                OP_PLENTY is BIP-110 working as intended.
              </p>
              <p class="mt-3 text-lg leading-8 text-muted-foreground">
                Where there used to be a straightforward carrier, there is now
                a custom 2:1 cipher hidden in executed script. Every file byte
                costs two script bytes, and anyone who wants the file back has
                to run a protocol-specific decoder.
              </p>
            </div>
          </section>
        </div>

        <footer class="mt-16 flex justify-end border-t border-border/60 pt-8">
          <a
            href="/responses"
            class="shrink-0 font-medium text-primary transition-colors hover:text-primary/80 hover:underline"
          >
            All responses →
          </a>
        </footer>
      </div>
    </article>

    <Footer />
  </main>
</Layout>
