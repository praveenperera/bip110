---
import Layout from "@/layouts/Layout.astro";
import Header from "@/components/Header.astro";
import { Card, CardContent, CardHeader, CardTitle } from "@/components/ui/card";

const knotsDownloadUrl = "https://bitcoinknots.org/";
const knotsReleaseNotesUrl =
  "https://github.com/bitcoinknots/bitcoin/releases/latest";
const knotsIssuesUrl = "https://github.com/bitcoinknots/bitcoin/issues";
const start9KnotsUrl = "https://github.com/Start9Labs/bitcoin-knots-startos";
const start9LegacyGuideUrl =
  "https://community.start9.com/t/guide-switching-from-bitcoin-core-to-bitcoin-knots-on-startos-v0-3-5-1/";
const umbrelKnotsUrl = "https://apps.umbrel.com/app/bitcoin-knots";
const myNodeKnotsPrUrl = "https://github.com/mynodebtc/mynode/pull/1000";
const dockerImage = "bitcoinknots/bitcoin:29.3.knots20260508";
const dockerTagsUrl = "https://hub.docker.com/r/bitcoinknots/bitcoin/tags";
---

<Layout
  title="How to Run BIP-110 — Step-by-Step Installation Guide"
  description="Install and run BIP-110 with the latest Bitcoin Knots release, Start9, Umbrel, myNode, Parmanode, or Docker. Choose your platform and start signaling."
  ogImage="/images/bip110-og-howto-dark.png"
>
  <main class="min-h-screen">
    <Header />

    <section class="pt-24 pb-24 px-6">
      <div class="max-w-4xl mx-auto">
        <h1 class="text-4xl font-bold mb-4">How to Run BIP-110</h1>
        <p class="text-xl text-muted-foreground mb-12">
          Support BIP-110 by running a node that signals for activation. Choose
          your preferred installation method below.
        </p>

        <div class="mb-12 rounded-lg border border-primary/20 bg-primary/5 p-4">
          <p class="text-sm text-muted-foreground">
            Bitcoin Knots 29.3.knots20260508 and newer include BIP-110/RDTS
            directly. Standard Knots installs no longer need the standalone
            BIP-110 fork.
          </p>
        </div>

        <div class="mb-12 grid gap-4 md:grid-cols-2">
          <div class="rounded-lg border border-primary/20 bg-primary/5 p-4">
            <p class="font-medium mb-2">
              Point rented hashpower at your DATUM node
            </p>
            <p class="text-sm text-muted-foreground">
              If you want to rent Braiins hashpower and point it at a BIP-110
              node through DATUM, follow the <a
                href="https://rentsomehash.com/guides/braiins-ocean/"
                target="_blank"
                rel="noopener noreferrer"
                class="text-primary hover:underline"
                >Rent Some Hash Braiins guide</a
              >. You can also use the <a
                href="https://rentsomehash.com/calculator/"
                target="_blank"
                rel="noopener noreferrer"
                class="text-primary hover:underline">hashpower calculator</a
              > before funding a bid.
            </p>
          </div>

          <div class="rounded-lg border border-border/60 bg-card/50 p-4">
            <p class="font-medium mb-2">Review the code before running it</p>
            <p class="text-sm text-muted-foreground">
              The <a
                href="/code-walkthrough"
                class="text-primary hover:underline">code walkthrough</a
              > shows the tagged Bitcoin Knots source behind the output limits, script
              rules, activation state, grandfathering, and expiry.
            </p>
          </div>
        </div>

        <div class="space-y-8">
          <Card>
            <CardHeader>
              <CardTitle>Bitcoin Knots (Latest Release)</CardTitle>
            </CardHeader>
            <CardContent className="space-y-4">
              <p class="text-muted-foreground">
                Download the official Bitcoin Knots release with BIP-110/RDTS
                support from bitcoinknots.org.
              </p>
              <div class="bg-muted/50 rounded-lg p-4 space-y-3">
                <p class="font-medium">Installation steps:</p>
                <ol
                  class="list-decimal list-inside space-y-2 text-sm text-muted-foreground"
                >
                  <li>
                    Download the latest release for your platform from
                    bitcoinknots.org
                  </li>
                  <li>Verify the digital fingerprints and signatures</li>
                  <li>Replace your existing Bitcoin Core/Knots installation</li>
                  <li>
                    Confirm RDTS in the GUI prompt, or add <code
                      class="bg-background rounded px-1"
                      >consensusrules=rdts</code
                    > to bitcoin.conf before starting bitcoind
                  </li>
                  <li>Start your node to signal and enforce BIP-110/RDTS</li>
                </ol>
              </div>
              <a
                href={knotsDownloadUrl}
                target="_blank"
                rel="noopener noreferrer"
                class="inline-flex items-center gap-2 px-4 py-2 bg-primary text-primary-foreground rounded-md hover:bg-primary/90 transition-colors"
              >
                Download Bitcoin Knots
                <svg
                  class="w-4 h-4"
                  fill="none"
                  stroke="currentColor"
                  viewBox="0 0 24 24"
                >
                  <path
                    stroke-linecap="round"
                    stroke-linejoin="round"
                    stroke-width="2"
                    d="M10 6H6a2 2 0 00-2 2v10a2 2 0 002 2h10a2 2 0 002-2v-4M14 4h6m0 0v6m0-6L10 14"
                  ></path>
                </svg>
              </a>
              <p class="text-sm text-muted-foreground">
                Release notes are available on the <a
                  href={knotsReleaseNotesUrl}
                  target="_blank"
                  rel="noopener noreferrer"
                  class="text-primary hover:underline"
                  >Bitcoin Knots latest release page</a
                >.
              </p>
            </CardContent>
          </Card>

          <div id="start9">
            <Card>
              <CardHeader>
                <CardTitle>Start9</CardTitle>
              </CardHeader>
              <CardContent className="space-y-4">
                <p class="text-muted-foreground">
                  Install or update Bitcoin Knots from the Start9 marketplace.
                  Current StartOS packages include BIP-110/RDTS directly.
                </p>
                <div class="bg-muted/50 rounded-lg p-4 space-y-3">
                  <p class="font-medium">Installation steps:</p>
                  <ol
                    class="list-decimal list-inside space-y-2 text-sm text-muted-foreground"
                  >
                    <li>
                      Open the Start9 marketplace and install or update Bitcoin
                      Knots
                    </li>
                    <li>Start the service and open the Dashboard</li>
                    <li>
                      Resolve the Activate RDTS critical task to acknowledge the
                      BIP-110/RDTS consensus rules
                    </li>
                    <li>
                      If you do not want RDTS, install the Bitcoin Knots
                      pre-RDTS flavor instead
                    </li>
                  </ol>
                </div>
                <div class="flex flex-col sm:flex-row sm:flex-wrap gap-3">
                  <a
                    href={start9KnotsUrl}
                    target="_blank"
                    rel="noopener noreferrer"
                    class="inline-flex items-center justify-center gap-2 px-4 py-2 bg-primary text-primary-foreground rounded-md hover:bg-primary/90 transition-colors w-full sm:w-auto"
                  >
                    View Start9 package
                    <svg
                      class="w-4 h-4"
                      fill="none"
                      stroke="currentColor"
                      viewBox="0 0 24 24"
                    >
                      <path
                        stroke-linecap="round"
                        stroke-linejoin="round"
                        stroke-width="2"
                        d="M10 6H6a2 2 0 00-2 2v10a2 2 0 002 2h10a2 2 0 002-2v-4M14 4h6m0 0v6m0-6L10 14"
                      ></path>
                    </svg>
                  </a>
                  <a
                    href={start9LegacyGuideUrl}
                    target="_blank"
                    rel="noopener noreferrer"
                    class="inline-flex items-center justify-center gap-2 px-4 py-2 border border-input bg-background rounded-md hover:bg-accent hover:text-accent-foreground transition-colors w-full sm:w-auto"
                  >
                    StartOS 0.3.5.1 guide
                    <svg
                      class="w-4 h-4"
                      fill="none"
                      stroke="currentColor"
                      viewBox="0 0 24 24"
                    >
                      <path
                        stroke-linecap="round"
                        stroke-linejoin="round"
                        stroke-width="2"
                        d="M10 6H6a2 2 0 00-2 2v10a2 2 0 002 2h10a2 2 0 002-2v-4M14 4h6m0 0v6m0-6L10 14"
                      ></path>
                    </svg>
                  </a>
                </div>
                <p class="text-sm text-muted-foreground">
                  Using StartOS with DATUM? The <a
                    href="https://rentsomehash.com/guides/startos/"
                    target="_blank"
                    rel="noopener noreferrer"
                    class="text-primary hover:underline"
                    >Rent Some Hash StartOS guide</a
                  > shows how to expose DATUM before creating a Braiins bid.
                </p>
              </CardContent>
            </Card>
          </div>

          <div id="umbrel">
            <Card>
              <CardHeader>
                <CardTitle>Umbrel</CardTitle>
              </CardHeader>
              <CardContent className="space-y-4">
                <p class="text-muted-foreground">
                  One-click install from the Umbrel community app store.
                </p>
                <div class="bg-muted/50 rounded-lg p-4 space-y-3">
                  <p class="font-medium">Installation steps:</p>
                  <ol
                    class="list-decimal list-inside space-y-2 text-sm text-muted-foreground"
                  >
                    <li>Open your Umbrel dashboard</li>
                    <li>
                      Update the Bitcoin Knots app if prompted in the App Store
                    </li>
                    <li>Open the Bitcoin Knots app</li>
                    <li>
                      Accept the BIP-110/RDTS upgrade in the Umbrel UI, or
                      switch to another version if you are not ready to adopt it
                    </li>
                    <li>Save settings and restart if prompted</li>
                  </ol>
                </div>
                <a
                  href={umbrelKnotsUrl}
                  target="_blank"
                  rel="noopener noreferrer"
                  class="inline-flex items-center gap-2 px-4 py-2 bg-primary text-primary-foreground rounded-md hover:bg-primary/90 transition-colors"
                >
                  View in Umbrel App Store
                  <svg
                    class="w-4 h-4"
                    fill="none"
                    stroke="currentColor"
                    viewBox="0 0 24 24"
                  >
                    <path
                      stroke-linecap="round"
                      stroke-linejoin="round"
                      stroke-width="2"
                      d="M10 6H6a2 2 0 00-2 2v10a2 2 0 002 2h10a2 2 0 002-2v-4M14 4h6m0 0v6m0-6L10 14"
                    ></path>
                  </svg>
                </a>
                <p class="text-sm text-muted-foreground">
                  Running DATUM on Umbrel too? The <a
                    href="https://rentsomehash.com/guides/umbrel/"
                    target="_blank"
                    rel="noopener noreferrer"
                    class="text-primary hover:underline"
                    >Rent Some Hash Umbrel guide</a
                  > walks through the endpoint Braiins needs.
                </p>
              </CardContent>
            </Card>
          </div>

          <div id="mynode">
            <Card>
              <CardHeader>
                <CardTitle>myNode</CardTitle>
              </CardHeader>
              <CardContent className="space-y-4">
                <p class="text-muted-foreground">
                  Available in myNode's Custom Bitcoin Version settings with a
                  confirmation prompt for the RDTS-enabled Knots release.
                </p>
                <div class="bg-muted/50 rounded-lg p-4 space-y-3">
                  <p class="font-medium">Installation steps:</p>
                  <ol
                    class="list-decimal list-inside space-y-2 text-sm text-muted-foreground"
                  >
                    <li>Update your myNode to the latest version</li>
                    <li>
                      Go to Settings and find the Custom Bitcoin Version section
                    </li>
                    <li>
                      Select Bitcoin Knots + BIP-110 (autoupdate), or the
                      pinned Bitcoin Knots + BIP-110 v29.3.knots20260508 option
                    </li>
                    <li>
                      Confirm the RDTS/BIP-110 prompt, then install and restart
                      when prompted
                    </li>
                  </ol>
                </div>
                <a
                  href={myNodeKnotsPrUrl}
                  target="_blank"
                  rel="noopener noreferrer"
                  class="inline-flex items-center gap-2 px-4 py-2 bg-primary text-primary-foreground rounded-md hover:bg-primary/90 transition-colors"
                >
                  View on GitHub
                  <svg
                    class="w-4 h-4"
                    fill="none"
                    stroke="currentColor"
                    viewBox="0 0 24 24"
                  >
                    <path
                      stroke-linecap="round"
                      stroke-linejoin="round"
                      stroke-width="2"
                      d="M10 6H6a2 2 0 00-2 2v10a2 2 0 002 2h10a2 2 0 002-2v-4M14 4h6m0 0v6m0-6L10 14"
                    ></path>
                  </svg>
                </a>
              </CardContent>
            </Card>
          </div>

          <div id="parmanode">
            <Card>
              <CardHeader>
                <CardTitle>Parmanode</CardTitle>
              </CardHeader>
              <CardContent className="space-y-4">
                <p class="text-muted-foreground">
                  Simple one-click style install for Parmanode users.
                </p>
                <div class="bg-muted/50 rounded-lg p-4 space-y-3">
                  <p class="font-medium">Installation steps:</p>
                  <ol
                    class="list-decimal list-inside space-y-2 text-sm text-muted-foreground"
                  >
                    <li>Make sure you have the latest Parmanode version</li>
                    <li>Install Bitcoin using Parmanode</li>
                    <li>
                      Select BIP-110 when the option appears during installation
                    </li>
                  </ol>
                </div>
                <a
                  href="https://www.youtube.com/watch?v=JpvNDL9Opns"
                  target="_blank"
                  rel="noopener noreferrer"
                  class="inline-flex items-center gap-2 px-4 py-2 bg-primary text-primary-foreground rounded-md hover:bg-primary/90 transition-colors"
                >
                  Watch Tutorial
                  <svg
                    class="w-4 h-4"
                    fill="none"
                    stroke="currentColor"
                    viewBox="0 0 24 24"
                  >
                    <path
                      stroke-linecap="round"
                      stroke-linejoin="round"
                      stroke-width="2"
                      d="M10 6H6a2 2 0 00-2 2v10a2 2 0 002 2h10a2 2 0 002-2v-4M14 4h6m0 0v6m0-6L10 14"
                    ></path>
                  </svg>
                </a>
              </CardContent>
            </Card>
          </div>

          <div id="docker">
            <Card>
              <CardHeader>
                <CardTitle>Docker</CardTitle>
              </CardHeader>
              <CardContent className="space-y-4">
                <p class="text-muted-foreground">
                  For advanced users running their own Docker infrastructure.
                  Use the current Bitcoin Knots image and enable RDTS in your
                  configuration.
                </p>
                <div class="bg-muted/50 rounded-lg p-4 space-y-3">
                  <p class="font-medium">Docker image:</p>
                  <code
                    class="block bg-background rounded px-3 py-2 text-sm font-mono break-all"
                  >
                    {dockerImage}
                  </code>
                  <p class="text-sm text-muted-foreground">
                    Add <code class="bg-background rounded px-1"
                      >consensusrules=rdts</code
                    > to bitcoin.conf before starting bitcoind.
                  </p>
                </div>
                <a
                  href={dockerTagsUrl}
                  target="_blank"
                  rel="noopener noreferrer"
                  class="inline-flex items-center gap-2 px-4 py-2 bg-primary text-primary-foreground rounded-md hover:bg-primary/90 transition-colors"
                >
                  View Docker tags
                  <svg
                    class="w-4 h-4"
                    fill="none"
                    stroke="currentColor"
                    viewBox="0 0 24 24"
                  >
                    <path
                      stroke-linecap="round"
                      stroke-linejoin="round"
                      stroke-width="2"
                      d="M10 6H6a2 2 0 00-2 2v10a2 2 0 002 2h10a2 2 0 002-2v-4M14 4h6m0 0v6m0-6L10 14"
                    ></path>
                  </svg>
                </a>
                <p class="text-sm text-muted-foreground">
                  Building a fresh DATUM box? The <a
                    href="https://rentsomehash.com/guides/vps/"
                    target="_blank"
                    rel="noopener noreferrer"
                    class="text-primary hover:underline"
                    >Rent Some Hash VPS guide</a
                  > covers the practical node and endpoint flow for rented hashpower.
                </p>
              </CardContent>
            </Card>
          </div>
        </div>

        <div class="mt-16 pt-8 border-t border-border">
          <h2 class="text-2xl font-bold mb-4">Need Help?</h2>
          <p class="text-muted-foreground mb-4">
            If you encounter any issues or have questions about running BIP-110,
            you can:
          </p>
          <ul class="list-disc list-inside space-y-2 text-muted-foreground">
            <li>
              Open an issue on the <a
                href={knotsIssuesUrl}
                target="_blank"
                rel="noopener noreferrer"
                class="text-primary hover:underline">GitHub repository</a
              >
            </li>
            <li>
              Read the full <a
                href="https://github.com/bitcoin/bips/blob/master/bip-0110.mediawiki"
                target="_blank"
                rel="noopener noreferrer"
                class="text-primary hover:underline">BIP-110 specification</a
              >
            </li>
          </ul>
        </div>
      </div>
    </section>
  </main>
</Layout>
